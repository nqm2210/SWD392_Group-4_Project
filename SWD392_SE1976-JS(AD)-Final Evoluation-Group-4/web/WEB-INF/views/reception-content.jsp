<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,java.time.LocalDate,hospital.model.AppointmentSummary" %>
<%! private String escReception(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String statusLabel(String status){switch(status==null?"":status){case "BOOKED":return "Đã đặt";case "CHECKED_IN":return "Đã check-in";case "IN_CONSULTATION":return "Đang khám";case "COMPLETED":return "Hoàn tất";case "CANCELLED":return "Đã hủy";case "NEEDS_PROCESSING":return "Cần xử lý";default:return status==null?"":status;}} %>
<%
String pageKey=(String)request.getAttribute("page");
String date=(String)request.getAttribute("date");
String status=(String)request.getAttribute("statusFilter");
String keyword=(String)request.getAttribute("keyword");
List<AppointmentSummary> appointments=(List<AppointmentSummary>)request.getAttribute("appointments");
String csrf=(String)request.getAttribute("csrfToken");
String title="appointments".equals(pageKey)?"Danh sách lịch hẹn":"check-in".equals(pageKey)?"Check-in bệnh nhân":"Hàng đợi hôm nay";
%>
<p class="muted">Tra cứu lịch hẹn trong database. Số thứ tự được cấp khi check-in và duy nhất theo bác sĩ trong ngày.</p>
<%if(request.getAttribute("receptionMessage")!=null){%><div class="notice notice-success" role="status"><%=escReception(request.getAttribute("receptionMessage").toString())%></div><%}%>
<%if(Boolean.TRUE.equals(request.getAttribute("checkedIn"))){%><div class="notice notice-success" role="status">Check-in thành công. Số thứ tự: <strong><%=escReception(String.valueOf(request.getAttribute("queueNumber")))%></strong> · Lượt khám đã hiển thị trạng thái chờ chốt hóa đơn tại mục <a href="<%=request.getContextPath()%>/dashboard?page=payments">Thanh toán tại quầy</a>.</div><%}%>
<%if(request.getAttribute("actionError")!=null){%><div class="notice notice-error" role="alert"><%=escReception(request.getAttribute("actionError").toString())%></div><%}%>
<%if(request.getAttribute("dateError")!=null){%><div class="notice notice-error" role="status"><%=escReception(request.getAttribute("dateError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escReception(request.getAttribute("loadError").toString())%></div><%}%>
<%if("appointments".equals(pageKey)){%><form method="get" action="<%=request.getContextPath()%>/reception/appointments" class="form-panel form-grid"><div class="form-field"><label for="appointment-date-filter">Ngày</label><input type="date" id="appointment-date-filter" name="date" value="<%=escReception(date)%>"></div><div class="form-field"><label for="appointment-status-filter">Trạng thái</label><select id="appointment-status-filter" name="status"><option value="">Tất cả</option><%for(String value:new String[]{"BOOKED","CHECKED_IN","IN_CONSULTATION","COMPLETED","CANCELLED","NEEDS_PROCESSING"}){%><option value="<%=value%>" <%if(value.equals(status)){%>selected<%}%>><%=statusLabel(value)%></option><%}%></select></div><div class="form-field"><label for="appointment-keyword">Mã lịch hẹn, tên hoặc điện thoại</label><input id="appointment-keyword" name="keyword" maxlength="100" value="<%=escReception(keyword)%>"></div><div class="form-field"><span>&nbsp;</span><button class="button button-primary" type="submit">Lọc lịch hẹn</button></div></form><%}else{%><p class="muted">Ngày: <%=escReception(LocalDate.now().toString())%></p><%}%>
<h3><%=title%></h3>
<%if(appointments==null){%><div class="empty-state"><strong>Chưa tải được dữ liệu.</strong></div><%}else if(appointments.isEmpty()){%><div class="empty-state"><strong>Không có lịch hẹn phù hợp.</strong><p>Thử chọn ngày hoặc trạng thái khác.</p></div><%}else{%><div class="table-scroll"><table class="data-table"><thead><tr><th>Giờ</th><th>Mã hẹn</th><th>Bệnh nhân</th><th>Điện thoại</th><th>Bác sĩ</th><th>Khoa</th><th>Trạng thái</th><th>Số thứ tự</th><th>Thao tác</th></tr></thead><tbody><%for(AppointmentSummary appointment:appointments){String start=appointment.startTime()==null?"":appointment.startTime().toString().substring(0,5);String end=appointment.endTime()==null?"":appointment.endTime().toString().substring(0,5);%><tr><td><%=escReception(start)%><%if(!end.isEmpty()){%>–<%=escReception(end)%><%}%></td><td><%=escReception(appointment.appointmentNumber())%></td><td><%=escReception(appointment.patientName())%></td><td><%=escReception(appointment.phone())%></td><td><%=escReception(appointment.doctorName())%></td><td><%=escReception(appointment.department())%></td><td><%=statusLabel(appointment.status())%></td><td><%=appointment.queueNumber()==null?"—":appointment.queueNumber()%></td><td><%if("BOOKED".equals(appointment.status())&&LocalDate.now().equals(appointment.appointmentDate())&&!("queue".equals(pageKey))){%><form method="post" action="<%=request.getContextPath()%>/reception/check-in" style="display:inline-block;"><input type="hidden" name="csrfToken" value="<%=escReception(csrf)%>"><input type="hidden" name="appointmentId" value="<%=appointment.id()%>"><button class="button button-primary" type="submit">Check-in</button></form><%}%><%if(("BOOKED".equals(appointment.status())||"NEEDS_PROCESSING".equals(appointment.status()))&&"appointments".equals(pageKey)){%><details class="doctor-edit"><summary>Hủy lịch</summary><form method="post" action="<%=request.getContextPath()%>/reception/appointments" class="staff-edit-form" onsubmit="return confirm('Xác nhận hủy lịch hẹn này?')"><input type="hidden" name="csrfToken" value="<%=escReception(csrf)%>"><input type="hidden" name="appointmentId" value="<%=appointment.id()%>"><input type="hidden" name="action" value="cancel"><div class="form-field"><label for="cancel-reason-<%=appointment.id()%>">Lý do hủy *</label><input id="cancel-reason-<%=appointment.id()%>" name="cancellationReason" maxlength="255" required placeholder="Nhập lý do hủy"></div><button class="button button-outline" type="submit">Hủy lịch</button></form></details><%}else if(!"BOOKED".equals(appointment.status())&&!"NEEDS_PROCESSING".equals(appointment.status())&&!("BOOKED".equals(appointment.status())&&LocalDate.now().equals(appointment.appointmentDate()))){%>—<%}%></td></tr><%}%></tbody></table></div><%}%>
