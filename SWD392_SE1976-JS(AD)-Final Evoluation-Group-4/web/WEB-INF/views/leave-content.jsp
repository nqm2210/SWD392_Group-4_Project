<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,java.time.format.DateTimeFormatter,hospital.model.LeaveRequest" %>
<%! private String escLeave(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String leaveError(Map<?,?> errors,String key){Object error=errors==null?null:errors.get(key);return error==null?"":"<span class=\"field-error\">"+escLeave(error.toString())+"</span>";} %>
<%
List<LeaveRequest> leaveRequests=(List<LeaveRequest>)request.getAttribute("leaveRequests");
Map<?,?> errors=(Map<?,?>)request.getAttribute("formErrors");
boolean manager="leave-approvals".equals(request.getAttribute("page"));
String csrf=(String)request.getAttribute("csrfToken");
String editId=(String)request.getAttribute("editLeaveId");
%>
<%if(request.getAttribute("leaveMessage")!=null){%><div class="notice notice-success" role="status"><%=escLeave(request.getAttribute("leaveMessage").toString())%></div><%}%>
<%if(request.getAttribute("formError")!=null){%><div class="notice notice-error" role="alert"><%=escLeave(request.getAttribute("formError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escLeave(request.getAttribute("loadError").toString())%></div><%}%>
<%if(!manager){%>
<p class="muted">Gửi yêu cầu nghỉ cho Manager xem xét. Đơn Pending chưa làm thay đổi lịch; đơn Approved/Rejected được lưu để tra cứu lịch sử.</p>
<section class="form-panel"><h3>Gửi yêu cầu nghỉ</h3><form method="post" action="<%=request.getContextPath()%>/leave-request" class="staff-edit-form">
<input type="hidden" name="csrfToken" value="<%=escLeave(csrf)%>">
<div class="form-grid"><div class="form-field"><label for="leave-start">Từ ngày</label><input type="date" id="leave-start" name="startDate" required value="<%=escLeave(request.getParameter("startDate"))%>"><%=leaveError(errors,"startDate")%></div>
<div class="form-field"><label for="leave-end">Đến ngày</label><input type="date" id="leave-end" name="endDate" required value="<%=escLeave(request.getParameter("endDate"))%>"><%=leaveError(errors,"endDate")%></div>
<div class="form-field full-width"><label for="leave-reason">Lý do nghỉ</label><textarea id="leave-reason" name="reason" maxlength="255" required><%=escLeave(request.getParameter("reason"))%></textarea><%=leaveError(errors,"reason")%></div></div>
<button class="button button-primary" type="submit">Gửi yêu cầu</button></form></section>
<h3>Yêu cầu của tôi</h3>
<%}else{%><p class="muted">Khi duyệt đơn Doctor, lượt BOOKED/CHECKED_IN chuyển sang “Cần xử lý”; lượt IN_CONSULTATION sẽ chặn duyệt để không làm gián đoạn khám. Đơn của Receptionist không thay đổi lịch bác sĩ. Hệ thống hiện chưa gửi SMS/email.</p><h3>Yêu cầu nghỉ</h3><%}%>
<%if(leaveRequests==null){%><div class="empty-state"><strong>Chưa tải được yêu cầu nghỉ.</strong><p>Kiểm tra kết nối database rồi thử lại.</p></div><%}else if(leaveRequests.isEmpty()){%><div class="empty-state"><strong><%=manager?"Không có yêu cầu chờ duyệt.":"Bạn chưa gửi yêu cầu nghỉ."%></strong></div><%}else{%>
<div class="doctor-admin-list"><%for(LeaveRequest leave:leaveRequests){%><article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3><%=escLeave(leave.fullName())%><%=manager?" · "+escLeave(leave.username()):""%></h3><p><%=escLeave(leave.startDate().toString())%> – <%=escLeave(leave.endDate().toString())%> · <%=escLeave(leave.status())%></p><p class="muted"><%=escLeave(leave.reason())%></p><p class="muted">Gửi lúc: <%=leave.createdAt()==null?"":leave.createdAt().format(DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%><%if(leave.approvedByName()!=null){%> · Người duyệt: <%=escLeave(leave.approvedByName())%><%}%></p><%if(manager&&leave.affectedAppointments()>0){%><p class="notice notice-error">Có <%=leave.affectedAppointments()%> lịch hẹn đang cần xử lý.</p><%}%><%if(leave.managerResponseReason()!=null&&!leave.managerResponseReason().isBlank()){%><p class="muted">Phản hồi Manager: <%=escLeave(leave.managerResponseReason())%></p><%}%></div></div>
<%if(!manager&&"Pending".equalsIgnoreCase(leave.status())){if(String.valueOf(leave.id()).equals(editId)){boolean editing="update".equals(request.getParameter("action"));%><form method="post" action="<%=request.getContextPath()%>/leave-request" class="staff-edit-form"><input type="hidden" name="csrfToken" value="<%=escLeave(csrf)%>"><input type="hidden" name="requestId" value="<%=leave.id()%>"><input type="hidden" name="action" value="update"><div class="form-grid"><div class="form-field"><label for="edit-leave-start-<%=leave.id()%>">Từ ngày</label><input type="date" id="edit-leave-start-<%=leave.id()%>" name="startDate" required value="<%=escLeave(editing?request.getParameter("startDate"):leave.startDate().toString())%>"><%=leaveError(errors,"startDate")%></div><div class="form-field"><label for="edit-leave-end-<%=leave.id()%>">Đến ngày</label><input type="date" id="edit-leave-end-<%=leave.id()%>" name="endDate" required value="<%=escLeave(editing?request.getParameter("endDate"):leave.endDate().toString())%>"><%=leaveError(errors,"endDate")%></div><div class="form-field full-width"><label for="edit-leave-reason-<%=leave.id()%>">Lý do</label><textarea id="edit-leave-reason-<%=leave.id()%>" name="reason" maxlength="255" required><%=escLeave(editing?request.getParameter("reason"):leave.reason())%></textarea><%=leaveError(errors,"reason")%></div></div><button class="button button-primary" type="submit">Lưu thay đổi</button></form><%}else{%><a class="button button-outline" href="<%=request.getContextPath()%>/dashboard?page=leave-request&amp;edit=<%=leave.id()%>">Sửa đơn Pending</a><%}}%>
<%if(manager&&"Pending".equalsIgnoreCase(leave.status())){%><form method="post" action="<%=request.getContextPath()%>/leave-approvals" class="staff-edit-form"><input type="hidden" name="csrfToken" value="<%=escLeave(csrf)%>"><input type="hidden" name="requestId" value="<%=leave.id()%>"><div class="form-field"><label for="response-<%=leave.id()%>">Lý do từ chối (bắt buộc khi từ chối)</label><input id="response-<%=leave.id()%>" name="managerResponseReason" maxlength="255"></div><div class="form-actions"><button class="button button-primary" type="submit" name="decision" value="APPROVE">Duyệt yêu cầu</button> <button class="button button-outline" type="submit" name="decision" value="REJECT">Từ chối</button></div></form><%}%>
</article><%}%></div><%}%>
