<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,java.time.LocalDate,java.time.format.DateTimeFormatter,hospital.model.ScheduleSummary" %>
<%! private String escSchedule(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String scheduleError(Map<?,?> errors,String key){Object value=errors==null?null:errors.get(key);return value==null?"":"<span class=\"field-error\">"+escSchedule(value.toString())+"</span>";} %>
<% List<ScheduleSummary> schedules=(List<ScheduleSummary>)request.getAttribute("schedules");String csrf=(String)request.getAttribute("csrfToken");Map<?,?> formErrors=(Map<?,?>)request.getAttribute("formErrors");String workDate=(String)request.getAttribute("postedWorkDate"),postedShift=(String)request.getAttribute("postedShift");if(workDate==null)workDate=LocalDate.now().toString(); %>
<p class="muted">Tạo và công bố ca làm việc của chính bạn. Mỗi ca có các khung 30 phút theo giờ làm việc hiện hành; bệnh nhân chỉ xem được slot sau khi ca được công bố.</p>
<%if(request.getAttribute("savedMessage")!=null){%><div class="notice notice-success" role="status"><%=request.getAttribute("savedMessage")%></div><%}%>
<%if(request.getAttribute("formError")!=null){%><div class="notice notice-error" role="alert"><%=escSchedule(request.getAttribute("formError").toString())%></div><%}%>
<form method="post" action="<%=request.getContextPath()%>/doctor/schedule" class="form-panel form-grid"><input type="hidden" name="csrfToken" value="<%=escSchedule(csrf)%>">
<div class="form-field"><label for="schedule-work-date">Ngày làm việc *</label><input id="schedule-work-date" type="date" name="workDate" required min="<%=LocalDate.now()%>" max="<%=LocalDate.now().plusYears(1)%>" value="<%=escSchedule(workDate)%>"><%=scheduleError(formErrors,"workDate")%></div>
<div class="form-field"><label for="schedule-shift">Ca khám *</label><select id="schedule-shift" name="shift" required><option value="">Chọn ca khám</option><option value="AM" <%= "AM".equals(postedShift)?"selected":""%>>Ca sáng · 08:00–12:00</option><option value="PM" <%= "PM".equals(postedShift)?"selected":""%>>Ca chiều · 13:00–17:00</option></select><%=scheduleError(formErrors,"shift")%></div>
<div class="form-field"><span>&nbsp;</span><button class="button button-primary" type="submit">Tạo và công bố ca</button></div></form>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=request.getAttribute("loadError")%></div><%}else if(schedules==null||schedules.isEmpty()){%><div class="empty-state"><strong>Chưa có ca khám.</strong><p>Danh sách sẽ hiển thị các ca bạn đã công bố.</p></div><%}else{%>
<div class="table-scroll"><table class="data-table"><thead><tr><th>Ngày</th><th>Ca</th><th>Thời gian</th><th>Khung giờ</th><th>Đã đặt</th><th>Đang mở</th><th>Trạng thái</th></tr></thead><tbody>
<%for(ScheduleSummary item:schedules){int available=Math.max(0,item.slotCount()-item.bookedCount()-item.blockedCount());%><tr><td><%=item.workDate().format(DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></td><td><%=item.shiftName()%></td><td><%=item.startTime()==null?"—":item.startTime().toString()%> – <%=item.endTime()==null?"—":item.endTime().toString()%></td><td><%=item.slotCount()%></td><td><%=item.bookedCount()%></td><td><%=available%></td><td><%="PUBLISHED".equals(item.status())?"Đang mở":"Đã đóng"%></td></tr><%}%>
</tbody></table></div><%}%>
