<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.StaffUser" %>
<%! private String esc(String s){return s==null?"":s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% StaffUser user=(StaffUser)session.getAttribute("staffUser");List<String> menus=(List<String>)request.getAttribute("menus");List<String> keys=(List<String>)request.getAttribute("menuKeys");String activePage=(String)request.getAttribute("page");int activeIndex=keys.indexOf(activePage);String pageTitle=activeIndex<0?menus.get(0):menus.get(activeIndex); %>
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tổng quan nhân viên</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/styles.css"></head><body class="dashboard-body"><aside class="sidebar"><a class="brand sidebar-brand" href="<%=request.getContextPath()%>/dashboard"><span class="brand-mark">AT</span><span>Bệnh viện An Tâm<small>Cổng nhân viên</small></span></a><nav aria-label="Menu chức năng"><%for(int i=0;i<menus.size();i++){String key=keys.get(i);%><a class="side-link <%=activePage.equals(key)?"selected":""%>" href="<%=request.getContextPath()%>/dashboard?page=<%=key%>" <%=activePage.equals(key)?"aria-current=page":""%>><%=esc(menus.get(i))%></a><%}%></nav><form method="post" action="<%=request.getContextPath()%>/logout"><button class="button button-outline button-full" type="submit">Đăng xuất</button></form></aside>
<main class="dashboard-main"><header class="dashboard-top"><div><p class="eyebrow">KHU VỰC NHÂN VIÊN</p><h1>Xin chào, <%=esc(user.fullName())%></h1><p class="muted">Vai trò: <%=esc(user.role())%><%=user.department()==null?"":" · "+esc(user.department())%></p></div></header><section class="dashboard-content"><h2><%=esc(pageTitle)%></h2>
<%if("staff".equals(activePage)){%><jsp:include page="staff-content.jsp"/><%}else if("services".equals(activePage)){%><jsp:include page="services-content.jsp"/><%}else if("medicines".equals(activePage)){%><jsp:include page="medicines-content.jsp"/><%}else if("leave-approvals".equals(activePage)||"leave-request".equals(activePage)){%><jsp:include page="leave-content.jsp"/><%}else if("registration".equals(activePage)){%><jsp:include page="registration-content.jsp"/><%}else if("appointments".equals(activePage)||"check-in".equals(activePage)||"queue".equals(activePage)){%><jsp:include page="reception-content.jsp"/><%}else if("payments".equals(activePage)){%><jsp:include page="payment-content.jsp"/><%}else if("activity-report".equals(activePage)||"revenue-report".equals(activePage)){%><jsp:include page="report-content.jsp"/><%}else if("schedule".equals(activePage)){%><jsp:include page="schedule-content.jsp"/><%}else if(List.of("consultation","patients","prescriptions","lab-orders").contains(activePage)){%><jsp:include page="doctor-content.jsp"/><%}else if(List.of("service-orders","patient-info","perform-service","results","service-history").contains(activePage)){%><jsp:include page="medical-staff-content.jsp"/><%}else if("feedback".equals(activePage)){%><div class="empty-state"><strong>Chưa thể triển khai phản hồi</strong><p>Database hiện tại chưa có bảng lưu phản hồi; trang này chưa nhận hoặc lưu nội dung.</p></div><%}else if("overview".equals(activePage)){%><div class="empty-state"><strong>Chức năng theo vai trò</strong><%if("Manager".equals(user.role())){%><p>Quản lý bác sĩ, dịch vụ, danh mục thuốc, duyệt đơn nghỉ và báo cáo hoạt động/doanh thu.</p><%}else if("Doctor".equals(user.role())){%><p>Lịch làm việc, hàng đợi, hồ sơ khám, kê đơn và chỉ định dịch vụ.</p><%}else if("Receptionist".equals(user.role())){%><p>Đăng ký tại quầy, tra cứu lịch hẹn, check-in và quản lý hàng đợi.</p><%}else{%><p>Tra cứu chỉ định và nhập/phát hành kết quả dịch vụ.</p><%}%><p class="muted">Chọn chức năng ở menu bên trái. Mục chưa được triển khai hoặc thiếu dữ liệu sẽ nêu rõ ngay trên trang.</p></div><%}else{%><div class="empty-state"><strong>Chức năng chưa triển khai</strong><p>Module này hiện chưa có luồng đọc/ghi hoàn chỉnh.</p></div><%}%>
</section></main></body></html>
