<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.StaffUser" %>
<%! private String esc(String s){return s==null?"":s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% StaffUser user=(StaffUser)session.getAttribute("staffUser");List<String> menus=(List<String>)request.getAttribute("menus");List<String> keys=(List<String>)request.getAttribute("menuKeys");String activePage=(String)request.getAttribute("page");int activeIndex=keys.indexOf(activePage);String pageTitle=activeIndex<0?menus.get(0):menus.get(activeIndex); %>
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=esc(pageTitle)%> | Group 4 Schedule Hospital System (SHS)</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/styles.css?v=4"></head><body class="dashboard-body"><aside class="sidebar"><a class="brand sidebar-brand" href="<%=request.getContextPath()%>/dashboard"><span class="brand-mark">SHS</span><span>Group 4 Schedule Hospital System<small>SHS · Cổng điều hành nội bộ</small></span></a><nav aria-label="Menu chức năng"><%for(int i=0;i<menus.size();i++){String key=keys.get(i);%><a class="side-link <%=activePage.equals(key)?"selected":""%>" href="<%=request.getContextPath()%>/dashboard?page=<%=key%>" <%=activePage.equals(key)?"aria-current=page":""%>><%=esc(menus.get(i))%></a><%}%></nav><form method="post" action="<%=request.getContextPath()%>/logout"><button class="button button-outline button-full" type="submit">Đăng xuất</button></form></aside>
<main class="dashboard-main"><header class="dashboard-top"><div><p class="eyebrow">GROUP 4 · SCHEDULE HOSPITAL SYSTEM (SHS)</p><h1>Xin chào, <%=esc(user.fullName())%></h1><p class="muted">Vai trò: <%=esc(user.role())%><%=user.department()==null?"":" · "+esc(user.department())%></p></div><span class="dashboard-role-pill"><%=esc(user.role())%> Portal</span></header><section class="dashboard-content"><h2><%=esc(pageTitle)%></h2>
<%if("staff".equals(activePage)){%><jsp:include page="staff-content.jsp"/><%}else if("services".equals(activePage)){%><jsp:include page="services-content.jsp"/><%}else if("medicines".equals(activePage)){%><jsp:include page="medicines-content.jsp"/><%}else if("leave-approvals".equals(activePage)||"leave-request".equals(activePage)){%><jsp:include page="leave-content.jsp"/><%}else if("registration".equals(activePage)){%><jsp:include page="registration-content.jsp"/><%}else if("appointments".equals(activePage)||"check-in".equals(activePage)||"queue".equals(activePage)){%><jsp:include page="reception-content.jsp"/><%}else if("payments".equals(activePage)){%><jsp:include page="payment-content.jsp"/><%}else if("activity-report".equals(activePage)||"revenue-report".equals(activePage)){%><jsp:include page="report-content.jsp"/><%}else if("schedule".equals(activePage)||"doctor-schedules".equals(activePage)){%><jsp:include page="schedule-content.jsp"/><%}else if(List.of("consultation","patients","prescriptions","lab-orders").contains(activePage)){%><jsp:include page="doctor-content.jsp"/><%}else{%><div class="empty-state"><strong>Chức năng chưa triển khai</strong><p>Module này hiện chưa có luồng đọc/ghi hoàn chỉnh.</p></div><%}%>
</section></main></body></html>
