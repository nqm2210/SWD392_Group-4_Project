<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.ActivityReportRow,hospital.model.RevenueReportRow" %>
<%! private String escReport(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String reportError(Map<?,?> errors,String key){Object error=errors==null?null:errors.get(key);return error==null?"":"<span class=\"field-error\">"+escReport(error.toString())+"</span>";} %>
<%
boolean revenue="revenue-report".equals(request.getAttribute("page"));
Map<?,?> errors=(Map<?,?>)request.getAttribute("formErrors");
List<ActivityReportRow> activityRows=(List<ActivityReportRow>)request.getAttribute("activityRows");
List<RevenueReportRow> revenueRows=(List<RevenueReportRow>)request.getAttribute("revenueRows");
String fromDate=(String)request.getAttribute("fromDate"),toDate=(String)request.getAttribute("toDate");
%>
<p class="muted">Báo cáo truy vấn dữ liệu hiện có theo khoảng ngày đã chọn.</p>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escReport(request.getAttribute("loadError").toString())%></div><%}%>
<form method="get" action="<%=request.getContextPath()%>/reports/<%=revenue?"revenue":"activity"%>" class="form-panel form-grid"><div class="form-field"><label for="report-from">Từ ngày</label><input type="date" id="report-from" name="fromDate" required value="<%=escReport(fromDate)%>"><%=reportError(errors,"fromDate")%></div><div class="form-field"><label for="report-to">Đến ngày</label><input type="date" id="report-to" name="toDate" required value="<%=escReport(toDate)%>"><%=reportError(errors,"toDate")%></div><div class="form-field"><span>&nbsp;</span><button class="button button-primary" type="submit">Xem báo cáo</button></div></form>
<%if(revenue){if(revenueRows==null){%><div class="empty-state"><strong>Chưa có báo cáo doanh thu.</strong><p>Chọn khoảng ngày hợp lệ để tải dữ liệu.</p></div><%}else if(revenueRows.isEmpty()){%><div class="empty-state"><strong>Không có khoản thanh toán trong khoảng ngày này.</strong></div><%}else{%><div class="table-scroll"><table class="data-table"><thead><tr><th>Khoa</th><th>Phương thức</th><th>Số thanh toán</th><th>Tổng đã thu</th></tr></thead><tbody><%for(RevenueReportRow row:revenueRows){%><tr><td><%=escReport(row.department())%></td><td><%=escReport(row.paymentMethod())%></td><td><%=row.paymentCount()%></td><td><%=String.format("%,.0f",row.amount())%> ₫</td></tr><%}%></tbody></table></div><%}}else if(activityRows==null){%><div class="empty-state"><strong>Chưa có báo cáo hoạt động.</strong><p>Chọn khoảng ngày hợp lệ để tải dữ liệu.</p></div><%}else if(activityRows.isEmpty()){%><div class="empty-state"><strong>Không có lịch hẹn trong khoảng ngày này.</strong></div><%}else{%><div class="table-scroll"><table class="data-table"><thead><tr><th>Ngày</th><th>Tổng</th><th>Đã đặt</th><th>Đã đến</th><th>Đang khám</th><th>Hoàn tất</th><th>Đã hủy</th><th>Cần xử lý</th><th>No-show</th></tr></thead><tbody><%for(ActivityReportRow row:activityRows){%><tr><td><%=row.date()%></td><td><%=row.total()%></td><td><%=row.booked()%></td><td><%=row.checkedIn()%></td><td><%=row.inConsultation()%></td><td><%=row.completed()%></td><td><%=row.cancelled()%></td><td><%=row.needsProcessing()%></td><td><%=row.noShow()%></td></tr><%}%></tbody></table></div><%}%>
