<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.MedicalService,hospital.model.Department,jakarta.servlet.http.HttpServletRequest" %>
<%! 
private String escService(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String postedServiceValue(HttpServletRequest req,int id,String field,String fallback){try{if("POST".equals(req.getMethod())&&Integer.parseInt(req.getParameter("serviceId"))==id){String value=req.getParameter(field);if(value!=null)return value;}}catch(Exception ignored){}return fallback==null?"":fallback;}
private String serviceFieldError(Map<?,?> errors,String key){Object error=errors==null?null:errors.get(key);return error==null?"":"<span class=\"field-error\">"+escService(error.toString())+"</span>";}
private Map<?,?> serviceErrorsForForm(HttpServletRequest req,Map<?,?> errors,int id){return "POST".equals(req.getMethod())&&String.valueOf(id).equals(req.getParameter("serviceId"))?errors:null;}
%>
<%
List<MedicalService> medicalServices=(List<MedicalService>)request.getAttribute("medicalServices");
List<Department> departments=(List<Department>)request.getAttribute("departments");
Map<?,?> errors=(Map<?,?>)request.getAttribute("formErrors");
boolean createActive="POST".equals(request.getMethod())&&"0".equals(request.getParameter("serviceId"))?request.getParameter("active")!=null:true;
%>
<p class="muted">Tạo dịch vụ, cập nhật giá và trạng thái hiển thị từ danh mục đang dùng trong database. Thuốc kê đơn không phải dịch vụ; hãy nhập thuốc tại mục <a href="<%=request.getContextPath()%>/dashboard?page=medicines">Danh mục thuốc</a>.</p>
<%if(request.getAttribute("savedMessage")!=null){%><div class="notice notice-success" role="status"><%=escService(request.getAttribute("savedMessage").toString())%></div><%}%>
<%if(request.getAttribute("formError")!=null){%><div class="notice notice-error" role="alert"><%=escService(request.getAttribute("formError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escService(request.getAttribute("loadError").toString())%></div><%}%>
<%Map<?,?> createErrors=serviceErrorsForForm(request,errors,0);%>
<section class="form-panel service-create-panel"><h3>Thêm dịch vụ</h3><form method="post" action="<%=request.getContextPath()%>/services" class="staff-edit-form">
<input type="hidden" name="csrfToken" value="<%=escService((String)request.getAttribute("csrfToken"))%>"><input type="hidden" name="serviceId" value="0">
<div class="form-grid">
<div class="form-field"><label for="new-service-code">Mã dịch vụ</label><input id="new-service-code" name="serviceCode" maxlength="20" required placeholder="VD: DV_XN_001" value="<%=escService(postedServiceValue(request,0,"serviceCode",""))%>"><small class="muted">Mã kỹ thuật không dấu, không khoảng trắng; tên tiếng Việt nhập ở ô kế tiếp.</small><%=serviceFieldError(createErrors,"serviceCode")%></div>
<div class="form-field"><label for="new-service-name">Tên dịch vụ</label><input id="new-service-name" name="serviceName" maxlength="100" required value="<%=escService(postedServiceValue(request,0,"serviceName",""))%>"><%=serviceFieldError(createErrors,"serviceName")%></div>
<div class="form-field"><label for="new-service-dept">Khoa</label><select id="new-service-dept" name="departmentId" required><option value="">Chọn khoa</option><%if(departments!=null)for(Department department:departments){String selected=String.valueOf(department.id()).equals(postedServiceValue(request,0,"departmentId",""))?"selected":"";%><option value="<%=department.id()%>" <%=selected%>><%=escService(department.name())%></option><%}%></select><%=serviceFieldError(createErrors,"departmentId")%></div>
<div class="form-field"><label for="new-service-price">Giá dịch vụ (₫)</label><input id="new-service-price" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,15})(?:\.[0-9]{1,2})?" maxlength="19" name="unitPrice" required value="<%=escService(postedServiceValue(request,0,"unitPrice",""))%>"><small class="muted">Tối đa 16 chữ số phần nguyên và 2 chữ số thập phân.</small><%=serviceFieldError(createErrors,"unitPrice")%></div>
<div class="form-field full-width"><label for="new-service-description">Mô tả</label><textarea id="new-service-description" name="description" maxlength="255"><%=escService(postedServiceValue(request,0,"description",""))%></textarea><%=serviceFieldError(createErrors,"description")%></div>
</div><label class="checkbox-field"><input type="checkbox" name="active" <%=createActive?"checked":""%>> Hoạt động ngay sau khi thêm</label><button class="button button-primary" type="submit">Thêm dịch vụ</button></form></section>
<h3>Danh sách dịch vụ</h3>
<%if(medicalServices==null){%><div class="empty-state"><strong>Chưa tải được danh sách.</strong><p>Kiểm tra kết nối database rồi tải lại.</p></div><%}else if(medicalServices.isEmpty()){%><div class="empty-state"><strong>Chưa có dịch vụ trong database.</strong><p>Danh sách sẽ hiện sau khi Manager thêm dịch vụ.</p></div><%}else{%>
<div class="doctor-admin-list"><%for(MedicalService service:medicalServices){int id=service.id();Map<?,?> serviceErrors=serviceErrorsForForm(request,errors,id);String code=postedServiceValue(request,id,"serviceCode",service.code());String name=postedServiceValue(request,id,"serviceName",service.name());String departmentId=postedServiceValue(request,id,"departmentId",String.valueOf(service.departmentId()));String price=postedServiceValue(request,id,"unitPrice",service.unitPrice().toPlainString());String description=postedServiceValue(request,id,"description",service.description());boolean active="POST".equals(request.getMethod())&&String.valueOf(id).equals(request.getParameter("serviceId"))?request.getParameter("active")!=null:service.active();%>
<article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3><%=escService(service.name())%></h3><p><%=escService(service.code())%> · <%=escService(service.departmentName())%></p><p class="muted"><%=service.active()?"Đang hoạt động":"Đã tạm ngưng"%></p></div><strong><%=String.format("%,.0f",service.unitPrice())%> ₫</strong></div>
<details class="doctor-edit" <%=serviceErrors!=null?"open":""%>><summary>Chỉnh sửa dịch vụ</summary><form method="post" action="<%=request.getContextPath()%>/services" class="staff-edit-form"><input type="hidden" name="csrfToken" value="<%=escService((String)request.getAttribute("csrfToken"))%>"><input type="hidden" name="serviceId" value="<%=id%>">
<div class="form-grid"><div class="form-field"><label for="service-code-<%=id%>">Mã dịch vụ</label><input id="service-code-<%=id%>" name="serviceCode" maxlength="20" required value="<%=escService(code)%>"><%=serviceFieldError(serviceErrors,"serviceCode")%></div>
<div class="form-field"><label for="service-name-<%=id%>">Tên dịch vụ</label><input id="service-name-<%=id%>" name="serviceName" maxlength="100" required value="<%=escService(name)%>"><%=serviceFieldError(serviceErrors,"serviceName")%></div>
<div class="form-field"><label for="service-dept-<%=id%>">Khoa</label><select id="service-dept-<%=id%>" name="departmentId" required><%if(departments!=null)for(Department department:departments){String selected=String.valueOf(department.id()).equals(departmentId)?"selected":"";%><option value="<%=department.id()%>" <%=selected%>><%=escService(department.name())%></option><%}%></select><%=serviceFieldError(serviceErrors,"departmentId")%></div>
<div class="form-field"><label for="service-price-<%=id%>">Giá dịch vụ (₫)</label><input id="service-price-<%=id%>" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,15})(?:\.[0-9]{1,2})?" maxlength="19" name="unitPrice" required value="<%=escService(price)%>"><%=serviceFieldError(serviceErrors,"unitPrice")%></div>
<div class="form-field full-width"><label for="service-description-<%=id%>">Mô tả</label><textarea id="service-description-<%=id%>" name="description" maxlength="255"><%=escService(description)%></textarea><%=serviceFieldError(serviceErrors,"description")%></div>
<label class="checkbox-field"><input type="checkbox" name="active" <%=active?"checked":""%>> Đang hoạt động</label></div><button class="button button-primary" type="submit">Lưu dịch vụ</button></form></details></article><%}%></div><%}%>
