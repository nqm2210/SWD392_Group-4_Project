<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.ServiceOrderSummary" %>
<%! private String escServiceOrder(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String serviceOrderStatus(String value){switch(value==null?"":value){case "ORDERED":return "Chờ thực hiện";case "IN_PROGRESS":return "Đang thực hiện";case "COMPLETED":return "Hoàn tất";case "CANCELLED":return "Đã hủy";case "DRAFT":return "Bản nháp";case "RELEASED":return "Đã phát hành";default:return value==null?"":value;}} %>
<%
String pageKey=(String)request.getAttribute("page"),selected=(String)request.getAttribute("selectedOrderId"),csrf=(String)request.getAttribute("csrfToken");
List<ServiceOrderSummary> orders=(List<ServiceOrderSummary>)request.getAttribute("serviceOrders");
String title="Nhập kết quả dịch vụ";
if("service-orders".equals(pageKey))title="Chỉ định dịch vụ";
else if("patient-info".equals(pageKey))title="Thông tin bệnh nhân theo chỉ định";
else if("perform-service".equals(pageKey))title="Thực hiện dịch vụ";
else if("service-history".equals(pageKey))title="Lịch sử dịch vụ";
String postedFindings=(String)request.getAttribute("postedFindings"),postedDetails=(String)request.getAttribute("postedDetails");
%>
<p class="muted">Danh sách lấy từ MedicalServiceOrders. Schema hiện không có bảng phân công chỉ định cho từng nhóm MedicalStaff.</p>
<%if(request.getAttribute("savedMessage")!=null){%><div class="notice notice-success" role="status"><%=request.getAttribute("savedMessage")%></div><%}%>
<%if(request.getAttribute("actionError")!=null){%><div class="notice notice-error" role="alert"><%=escServiceOrder(request.getAttribute("actionError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escServiceOrder(request.getAttribute("loadError").toString())%></div><%}%>
<h3><%=title%></h3>
<%if(orders==null){%><div class="empty-state">Chưa tải được dữ liệu.</div><%}else if(orders.isEmpty()){%><div class="empty-state"><strong>Chưa có chỉ định dịch vụ.</strong><p>Chỉ định xuất hiện sau khi Doctor tạo hồ sơ khám và chọn dịch vụ.</p></div><%}else{%>
<div class="table-scroll"><table class="data-table"><thead><tr><th>Mã chỉ định</th><th>Bệnh nhân</th><th>Bác sĩ</th><th>Khoa</th><th>Dịch vụ</th><th>Ưu tiên</th><th>Trạng thái</th><th>Kết quả</th><th></th></tr></thead><tbody>
<%for(ServiceOrderSummary order:orders){boolean selectedOrder=false;try{selectedOrder=order.orderId()==Integer.parseInt(selected==null?"-1":selected);}catch(NumberFormatException ignored){}boolean open=!("COMPLETED".equalsIgnoreCase(order.orderStatus())||"CANCELLED".equalsIgnoreCase(order.orderStatus()))&&!("RELEASED".equalsIgnoreCase(order.resultStatus()));%><tr><td><%=escServiceOrder(order.orderNumber())%></td><td><%=escServiceOrder(order.patientName())%></td><td><%=escServiceOrder(order.doctorName())%></td><td><%=escServiceOrder(order.department())%></td><td><%=escServiceOrder(order.serviceName())%></td><td><%=escServiceOrder(order.priority())%></td><td><%=serviceOrderStatus(order.orderStatus())%></td><td><%=serviceOrderStatus(order.resultStatus())%></td><td><%if(open){%><a class="button button-outline" href="<%=request.getContextPath()%>/medical-staff/results?orderId=<%=order.orderId()%>">Nhập kết quả</a><%}%></td></tr>
<%if(selectedOrder&&open){%><tr><td colspan="9"><div class="form-panel"><h3><%=escServiceOrder(order.serviceName())%> · <%=escServiceOrder(order.patientName())%></h3><p><%=escServiceOrder(order.instructions())%></p><form method="post" action="<%=request.getContextPath()%>/medical-staff/results" class="form-grid"><input type="hidden" name="csrfToken" value="<%=escServiceOrder(csrf)%>"><input type="hidden" name="orderId" value="<%=order.orderId()%>"><div class="form-field"><label for="findings-<%=order.orderId()%>">Kết luận *</label><textarea id="findings-<%=order.orderId()%>" name="findings" maxlength="12000" required><%=escServiceOrder(postedFindings==null?order.resultFindings():postedFindings)%></textarea></div><div class="form-field"><label for="details-<%=order.orderId()%>">Chi tiết kết quả</label><textarea id="details-<%=order.orderId()%>" name="resultDetails" maxlength="12000"><%=escServiceOrder(postedDetails==null?order.resultDetails():postedDetails)%></textarea></div><div class="form-field"><span>&nbsp;</span><div class="button-row"><button class="button button-outline" type="submit" name="action" value="save">Lưu bản nháp</button><button class="button button-primary" type="submit" name="action" value="release">Phát hành kết quả</button></div></div></form></div></td></tr><%}%><%}%>
</tbody></table></div><%}%>
