<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,java.time.LocalDate,hospital.model.Doctor,hospital.model.PatientLookupResult" %>
<%! private String escRegistration(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String regValue(jakarta.servlet.http.HttpServletRequest req,String key){return regValue(req,key,null);} private String regValue(jakarta.servlet.http.HttpServletRequest req,String key,PatientLookupResult patient){String v=req.getParameter(key);if(v==null&&patient!=null){if("fullName".equals(key))v=patient.fullName();else if("dateOfBirth".equals(key))v=patient.dateOfBirth().toString();else if("gender".equals(key))v=patient.gender();else if("phone".equals(key))v=patient.phone();else if("email".equals(key))v=patient.email();}return escRegistration(v==null?"":v);} private String regError(Map<?,?> errors,String key){Object v=errors==null?null:errors.get(key);return v==null?"":"<span class=\"field-error\">"+escRegistration(v.toString())+"</span>";} %>
<%
List<Doctor> doctors=(List<Doctor>)request.getAttribute("doctors");Map<?,?> errors=(Map<?,?>)request.getAttribute("fieldErrors");String csrf=(String)request.getAttribute("csrfToken");
PatientLookupResult lookup=(PatientLookupResult)request.getAttribute("lookupPatient");
%>
<p class="muted">Tạo hồ sơ bệnh nhân và lịch hẹn tại quầy. Khung giờ lấy từ lịch theo bác sĩ/ngày; thao tác lưu và ghi audit cùng transaction.</p>
<%if(Boolean.TRUE.equals(request.getAttribute("saved"))){%><div class="notice notice-success" role="status">Đã lưu lịch hẹn vào database. Mã lịch: <strong><%=escRegistration((String)request.getAttribute("savedAppointmentNumber"))%></strong>.<%if(request.getAttribute("issuedAccessCode")!=null){%><p>Mã truy cập bệnh nhân chỉ hiển thị một lần để bàn giao trực tiếp: <strong><%=escRegistration(request.getAttribute("issuedAccessCode").toString())%></strong>. Hãy hướng dẫn bệnh nhân lưu mã này an toàn.</p><%}else{%><p>Hồ sơ đã tồn tại; hệ thống không tiết lộ hoặc cấp lại mã truy cập từ số điện thoại. Bệnh nhân cần dùng mã đã có hoặc xác minh trực tiếp tại quầy.</p><%}%></div><%}%>
<%if(request.getAttribute("formError")!=null){%><div class="notice notice-error" role="alert"><%=escRegistration(request.getAttribute("formError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escRegistration(request.getAttribute("loadError").toString())%></div><%}%>
<section class="form-panel"><h2>Tra cứu hồ sơ đã có</h2><p class="muted">Tìm chính xác theo số điện thoại, số giấy tờ hoặc mã hồ sơ. Không hiển thị mã truy cập bệnh nhân.</p>
<%if(request.getAttribute("lookupError")!=null){%><div class="notice notice-error" role="alert"><%=escRegistration(request.getAttribute("lookupError").toString())%></div><%}%>
<%if(request.getAttribute("lookupMessage")!=null){%><div class="notice" role="status"><%=escRegistration(request.getAttribute("lookupMessage").toString())%></div><%}%>
<%if(lookup!=null){%><div class="notice" role="status">Đã xác minh hồ sơ <strong><%=escRegistration(lookup.fullName())%></strong> · Mã hồ sơ <%=lookup.patientId()%>. Kiểm tra giấy tờ trực tiếp trước khi tiếp nhận; nội dung này chưa tự gắn hồ sơ vào lịch hẹn.</div><%}%>
<form method="post" action="<%=request.getContextPath()%>/reception/registration" class="form-grid"><input type="hidden" name="csrfToken" value="<%=escRegistration(csrf)%>"><input type="hidden" name="action" value="lookupPatient"><div class="form-field"><label for="patient-lookup">Số điện thoại, mã giấy tờ hoặc mã hồ sơ</label><input id="patient-lookup" name="patientLookup" maxlength="20" value="<%=escRegistration((String)request.getAttribute("lookupQuery"))%>" required></div><div class="form-field"><button class="button button-outline" type="submit">Tra cứu hồ sơ</button></div></form></section>
<%if(doctors==null||doctors.isEmpty()){%><div class="empty-state"><strong>Chưa có bác sĩ nhận lịch.</strong><p>Không thể gửi đăng ký khi chưa có bác sĩ công khai và khung giờ khả dụng.</p></div><%}else{%>
<form id="walk-in-form" method="post" action="<%=request.getContextPath()%>/reception/registration" class="form-panel form-grid">
<input type="hidden" name="csrfToken" value="<%=escRegistration(csrf)%>">
<div class="form-field"><label for="walk-name">Họ và tên *</label><input id="walk-name" name="fullName" maxlength="100" required value="<%=regValue(request,"fullName",lookup)%>"><%=regError(errors,"fullName")%></div>
<div class="form-field"><label for="walk-birth">Ngày sinh *</label><input id="walk-birth" type="date" name="dateOfBirth" max="<%=LocalDate.now()%>" required value="<%=regValue(request,"dateOfBirth",lookup)%>"><%=regError(errors,"dateOfBirth")%></div>
<div class="form-field"><label for="walk-gender">Giới tính *</label><select id="walk-gender" name="gender" required><option value="">Chọn giới tính</option><%for(String gender:new String[]{"Nam","Nữ","Khác"}){%><option value="<%=gender%>" <%=gender.equals(regValue(request,"gender",lookup))?"selected":""%>><%=gender%></option><%}%></select><%=regError(errors,"gender")%></div>
<div class="form-field"><label for="walk-phone">Số điện thoại *</label><input id="walk-phone" name="phone" maxlength="20" required value="<%=regValue(request,"phone",lookup)%>"><%=regError(errors,"phone")%></div>
<div class="form-field"><label for="walk-email">Email</label><input id="walk-email" type="email" name="email" maxlength="100" value="<%=regValue(request,"email",lookup)%>"><%=regError(errors,"email")%></div>
<div class="form-field"><label for="walk-doctor">Bác sĩ *</label><select id="walk-doctor" name="doctorId" required><option value="">Chọn bác sĩ</option><%for(Doctor doctor:doctors){%><option value="<%=doctor.id()%>" <%=String.valueOf(doctor.id()).equals(request.getParameter("doctorId"))?"selected":""%>><%=escRegistration(doctor.title()+" "+doctor.fullName()+" — "+doctor.specialization())%></option><%}%></select><%=regError(errors,"doctorId")%></div>
<div class="form-field"><label for="walk-date">Ngày khám *</label><input id="walk-date" type="date" name="appointmentDate" required min="<%=LocalDate.now()%>" value="<%=regValue(request,"appointmentDate")%>"><%=regError(errors,"appointmentDate")%></div>
<div class="form-field"><label for="walk-shift">Ca khám *</label><select id="walk-shift" name="shift" required><option value="">Chọn ca khám</option><option value="AM" <%= "AM".equals(request.getParameter("shift"))?"selected":""%>>Ca sáng · 08:00–12:00</option><option value="PM" <%= "PM".equals(request.getParameter("shift"))?"selected":""%>>Ca chiều · 13:00–17:00</option></select><%=regError(errors,"shift")%></div>
<div class="form-field"><label for="walk-slot">Khung giờ *</label><select id="walk-slot" name="slotId" required disabled><option value="">Chọn bác sĩ, ngày, ca trước</option></select><%=regError(errors,"slotId")%></div>
<div class="form-field full-width"><label for="walk-reason">Lý do khám *</label><textarea id="walk-reason" name="reason" maxlength="255" required><%=regValue(request,"reason")%></textarea><%=regError(errors,"reason")%></div>
<p id="walk-slot-help" class="muted full-width" role="status">Chưa tải khung giờ.</p>
<div class="form-field full-width"><button class="button button-primary" type="submit" <%=doctors.isEmpty()?"disabled":""%>>Đăng ký và tạo lịch</button></div>
</form>
<script>
(()=>{const doctor=document.getElementById('walk-doctor'),date=document.getElementById('walk-date'),shift=document.getElementById('walk-shift'),slot=document.getElementById('walk-slot'),help=document.getElementById('walk-slot-help');
let activeRequest;let requestVersion=0;
async function load(){const version=++requestVersion;if(activeRequest)activeRequest.abort();slot.replaceChildren(new Option('Đang tải khung giờ…',''));slot.disabled=true;if(!doctor.value||!date.value||!shift.value){slot.replaceChildren(new Option('Chọn bác sĩ, ngày, ca trước',''));help.textContent='Chưa tải khung giờ.';return;}activeRequest=new AbortController();try{const u=new URL('<%=request.getContextPath()%>/slots',location.origin);u.searchParams.set('doctorId',doctor.value);u.searchParams.set('date',date.value);u.searchParams.set('shift',shift.value);const response=await fetch(u,{signal:activeRequest.signal});if(!response.ok)throw new Error();const items=await response.json();if(version!==requestVersion)return;slot.replaceChildren(new Option(items.length?'Chọn khung giờ':'Không còn khung giờ',''));for(const item of items)slot.add(new Option(item.label,item.id));slot.disabled=items.length===0;if(items.length)help.textContent='';else if(response.headers.get('X-Slot-Availability')==='NOT_PUBLISHED')help.textContent='Bác sĩ chưa công bố lịch cho ngày và ca này. Vui lòng chọn ca hoặc ngày khác.';else help.textContent='Lịch đã công bố nhưng hiện không còn khung giờ trống. Vui lòng chọn ca hoặc ngày khác.';const selected='<%=regValue(request,"slotId")%>';if(selected&&items.some(x=>String(x.id)===selected))slot.value=selected;}catch(err){if(err.name==='AbortError'||version!==requestVersion)return;slot.replaceChildren(new Option('Không tải được khung giờ',''));help.textContent='Không tải được dữ liệu lịch. Thử lại sau.';}}
[doctor,date,shift].forEach(control=>control.addEventListener('change',load));if(doctor.value&&date.value&&shift.value)load();})();
</script>
<%}%>
