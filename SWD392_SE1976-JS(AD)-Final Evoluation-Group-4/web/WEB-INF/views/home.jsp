<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.Doctor" %>
<%!
private String esc(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String field(Map<?,?> errors,String name){Object error=errors==null?null:errors.get(name);return error==null?"":"<span class=\"field-error\">"+esc(error.toString())+"</span>";}
%>
<%
String ctx=request.getContextPath(); List<Doctor> doctors=(List<Doctor>)request.getAttribute("doctors");
Map<?,?> fieldErrors=(Map<?,?>)request.getAttribute("fieldErrors");
String[] fields={"fullName","dateOfBirth","gender","phone","email","reason","doctorId","appointmentDate","slotId"};
String[] params={"fullName","dateOfBirth","gender","phone","email","reason","doctorId","appointmentDate","slotId"};
String loginMessage=""; String loginState=request.getParameter("login");
if("failed".equals(loginState))loginMessage="Tên đăng nhập hoặc mật khẩu không chính xác.";
else if("unavailable".equals(loginState))loginMessage="Không thể kết nối hệ thống đăng nhập. Vui lòng thử lại sau.";
else if("required".equals(loginState))loginMessage="Vui lòng đăng nhập để tiếp tục.";
else if("expired".equals(loginState))loginMessage="Phiên đăng nhập đã hết hạn. Vui lòng tải lại trang và thử lại.";
%>
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Trang chủ | Group 4 Schedule Hospital System (SHS)</title><link rel="stylesheet" href="<%=ctx%>/assets/styles.css?v=4"></head><body>
<div class="top-bar"><div class="container top-bar-row"><div class="top-bar-items"><span class="top-bar-badge">SHS PORTAL</span><span>Group 4 Schedule Hospital System · Cổng đặt lịch &amp; quản lý khám chữa bệnh</span></div><div class="top-bar-items"><span>Ca sáng: 08:00–12:00</span><span>·</span><span>Ca chiều: 13:00–17:00</span></div></div></div>
<header class="site-header"><div class="container header-row"><a class="brand" href="<%=ctx%>/" aria-label="Group 4 Schedule Hospital System - Trang chủ"><span class="brand-mark">SHS</span><span>Group 4 Schedule Hospital System<small>SHS · Hệ thống đặt lịch &amp; điều hành bệnh viện</small></span></a><nav class="top-nav"><a href="#bac-si">Đội ngũ bác sĩ</a><a href="#dat-lich">Đặt lịch khám</a><a href="<%=ctx%>/patient">Cổng bệnh nhân</a></nav><button class="button button-primary" type="button" id="open-login">Đăng nhập nội bộ</button></div></header>
<main><section class="hero"><div class="container hero-content"><div class="hero-grid"><div><p class="eyebrow">GROUP 4 · SCHEDULE HOSPITAL SYSTEM (SHS)</p><h1>Đặt lịch khám chủ động,<br>điều phối y tế thông minh.</h1><p class="hero-lead">Hệ thống kết nối trực tiếp lịch làm việc đã công bố của bác sĩ chuyên khoa, giúp bệnh nhân đặt khung giờ khám chính xác và theo dõi hồ sơ an toàn.</p><div class="hero-actions"><a class="button button-primary" href="#dat-lich">Đăng ký lịch khám ngay</a><a class="button button-outline" href="<%=ctx%>/patient">Tra cứu &amp; quản lý lịch hẹn</a></div><div class="hero-pills"><span class="hero-pill">Đồng bộ lịch bác sĩ thời gian thực</span><span class="hero-pill">Cấp mã truy cập bảo mật 1 lần</span><span class="hero-pill">Đổi lịch trước 12h · Hủy trước 2h</span></div></div><aside class="hero-card"><div class="hero-card-header"><h3>Quy trình khám chuẩn SHS</h3><span class="badge">4 Bước</span></div><ul class="step-list"><li><span class="step-num">01</span><div><strong>Chọn bác sĩ &amp; chuyên khoa</strong><br>Tra cứu bác sĩ đang nhận lịch khám phù hợp nhu cầu.</div></li><li><span class="step-num">02</span><div><strong>Đặt khung giờ thực tế</strong><br>Hệ thống tải các slot trống từ lịch công bố của bác sĩ.</div></li><li><span class="step-num">03</span><div><strong>Nhận mã truy cập hồ sơ</strong><br>Lưu lại mã bảo mật để tra cứu, đổi hoặc hủy lịch trực tuyến.</div></li><li><span class="step-num">04</span><div><strong>Check-in &amp; khám bệnh</strong><br>Đến quầy lễ tân nhận số thứ tự, vào khám và nhận chỉ định.</div></li></ul></aside></div><div class="stats-strip"><div class="stat-box"><strong>Lịch Khám Thực Tế</strong><span>Chỉ mở các khung giờ bác sĩ đã công bố</span></div><div class="stat-box"><strong>Chống Trùng Slot</strong><span>Khóa giao dịch an toàn khi đặt lịch</span></div><div class="stat-box"><strong>Hồ Sơ Khép Kín</strong><span>Khám lâm sàng, kê đơn &amp; cận lâm sàng</span></div><div class="stat-box"><strong>Bảo Mật Truy Cập</strong><span>Xác thực bệnh nhân bằng mã băm SHA-256</span></div></div></div></section>
<section class="section container" id="bac-si"><div class="section-heading"><div><p class="eyebrow">ĐỘI NGŨ CHUYÊN MÔN SHS</p><h2>Danh sách bác sĩ đang nhận lịch</h2><p class="muted">Tìm bác sĩ theo họ tên hoặc chuyên khoa và chọn đặt lịch nhanh.</p></div><form class="search-form" method="get" action="<%=ctx%>/"><label class="sr-only" for="doctor-search">Tìm bác sĩ</label><input id="doctor-search" name="q" type="search" placeholder="Nhập tên bác sĩ, chuyên khoa..." value="<%=esc(request.getParameter("q"))%>"><button class="button button-primary button-sm" type="submit">Tìm kiếm</button></form></div>
<% if(request.getAttribute("doctorError")!=null){%><div class="notice notice-error" role="alert"><%=esc(request.getAttribute("doctorError").toString())%></div><%} else if(doctors==null||doctors.isEmpty()){%><div class="empty-state"><strong>Chưa có bác sĩ được công khai.</strong><p>Danh sách sẽ hiển thị khi hồ sơ bác sĩ được kích hoạt và cho phép công khai.</p></div><%} else {%><div class="doctor-list"><% for(Doctor d:doctors){%><article class="doctor-row"><div class="doctor-card-top"><div class="doctor-avatar" aria-hidden="true">BS</div><div class="doctor-info"><h3><%=esc(d.title())%> <%=esc(d.fullName())%></h3><p><span class="badge"><%=esc(d.specialization())%></span></p><p class="muted">Khoa: <%=esc(d.department())%></p></div></div><div class="doctor-card-footer"><span class="room-pill">Phòng <%=esc(d.roomNumber())%></span><a class="button button-outline button-sm" href="#dat-lich" onclick="const s=document.getElementById('doctorId');if(s){s.value='<%=d.id()%>';s.dispatchEvent(new Event('change'));}">Chọn đặt lịch</a></div></article><%}%></div><%}%>
</section>
<section class="section booking-section" id="dat-lich"><div class="container"><div class="section-heading"><div><p class="eyebrow">ĐĂNG KÝ KHÁM BỆNH TRỰC TUYẾN</p><h2>Thông tin bệnh nhân và lịch khám</h2><p class="muted">Khung giờ được tải trực tiếp từ lịch làm việc đã công bố của bác sĩ.</p></div></div>
<% if(request.getAttribute("bookingSuccess")!=null){%><div class="notice notice-success" role="status"><%=esc(request.getAttribute("bookingSuccess").toString())%></div><%}%>
<% if(request.getAttribute("oneTimePatientAccessCode")!=null){%><div class="notice notice-success" role="status"><p>Mã lịch hẹn: <strong><%=esc(String.valueOf(request.getAttribute("bookingAppointmentNumber")))%></strong></p><p>Mã truy cập bệnh nhân (chỉ hiển thị lần này): <strong><%=esc(request.getAttribute("oneTimePatientAccessCode").toString())%></strong></p><p>Hãy ghi lại mã này. Vì lý do bảo mật, bệnh viện không thể cấp lại chỉ bằng số điện thoại hoặc email.</p></div><%}%>
<% if(request.getAttribute("bookingError")!=null){%><div class="notice notice-error" role="alert"><%=esc(request.getAttribute("bookingError").toString())%></div><%}%>
<form id="appointment-form" class="form-panel" method="post" action="<%=ctx%>/appointment" novalidate>
<div class="booking-panel-banner"><div><h3>Phiếu đăng ký khám bệnh trực tuyến</h3><span>Điền đầy đủ các trường có dấu (*) để hệ thống giữ khung giờ khám</span></div><span class="top-bar-badge">SHS BOOKING</span></div>
<input type="hidden" name="csrfToken" value="<%=esc((String)request.getAttribute("csrfToken"))%>">
<div class="form-grid"><div class="form-field"><label for="fullName">Họ và tên <span>*</span></label><input id="fullName" name="fullName" maxlength="100" required value="<%=esc(request.getParameter("fullName"))%>"><%=field(fieldErrors,"fullName")%></div>
<div class="form-field"><label for="dateOfBirth">Ngày sinh <span>*</span></label><input id="dateOfBirth" type="date" name="dateOfBirth" max="<%=java.time.LocalDate.now()%>" required value="<%=esc(request.getParameter("dateOfBirth"))%>"><small class="muted">Ngày sinh không thể sau hôm nay. Hệ thống gửi ngày theo định dạng yyyy-MM-dd.</small><%=field(fieldErrors,"dateOfBirth")%></div>
<div class="form-field"><label for="gender">Giới tính <span>*</span></label><select id="gender" name="gender" required><option value="">Chọn giới tính</option><%for(String gender:new String[]{"Nam","Nữ","Khác"}){%><option <%=gender.equals(request.getParameter("gender"))?"selected":""%>><%=gender%></option><%}%></select><%=field(fieldErrors,"gender")%></div>
<div class="form-field"><label for="phone">Số điện thoại <span>*</span></label><input id="phone" name="phone" type="tel" maxlength="20" required value="<%=esc(request.getParameter("phone"))%>"><%=field(fieldErrors,"phone")%></div>
<div class="form-field"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="100" value="<%=esc(request.getParameter("email"))%>"><%=field(fieldErrors,"email")%></div>
<div class="form-field"><label for="doctorId">Bác sĩ <span>*</span></label><select id="doctorId" name="doctorId" required><option value="">Chọn bác sĩ</option><%if(doctors!=null)for(Doctor doctor:doctors){%><option value="<%=doctor.id()%>" <%=String.valueOf(doctor.id()).equals(request.getParameter("doctorId"))?"selected":""%>><%=esc(doctor.title())%> <%=esc(doctor.fullName())%> — <%=esc(doctor.specialization())%></option><%}%></select><%=field(fieldErrors,"doctorId")%></div>
<div class="form-field"><label for="appointmentDate">Ngày khám <span>*</span></label><input id="appointmentDate" name="appointmentDate" type="date" required min="<%=java.time.LocalDate.now()%>" value="<%=esc(request.getParameter("appointmentDate"))%>"><%=field(fieldErrors,"appointmentDate")%></div>
<div class="form-field"><label for="shift">Ca khám <span>*</span></label><select id="shift" name="shift" required><option value="">Chọn ca khám</option><option value="AM" <%= "AM".equals(request.getParameter("shift"))?"selected":""%>>Ca sáng · 08:00–12:00</option><option value="PM" <%= "PM".equals(request.getParameter("shift"))?"selected":""%>>Ca chiều · 13:00–17:00</option></select><small class="muted">Khung giờ chỉ hiển thị khi bác sĩ đã công bố lịch làm việc.</small></div>
<div class="form-field"><label for="slotId">Khung giờ còn trống <span>*</span></label><select id="slotId" name="slotId" data-selected="<%=esc(request.getParameter("slotId"))%>" required disabled><option value="">Chọn bác sĩ, ngày và ca khám trước</option></select><%=field(fieldErrors,"slotId")%><small id="slot-help" class="muted" aria-live="polite"></small></div>
<div class="form-field full-width"><label for="reason">Lý do khám / triệu chứng <span>*</span></label><textarea id="reason" name="reason" maxlength="255" rows="3" required><%=esc(request.getParameter("reason"))%></textarea><%=field(fieldErrors,"reason")%></div></div>
<p class="form-note">Thông tin cá nhân chỉ được dùng để tiếp nhận yêu cầu khám. Số điện thoại phải chưa có trong hồ sơ bệnh nhân.</p><button class="button button-primary" id="submit-appointment" type="submit">Gửi yêu cầu đặt lịch</button><span id="appointment-status" class="muted" aria-live="polite"></span></form></div></section></main>
<footer class="site-footer"><div class="container"><div class="footer-grid"><div class="footer-col"><h4>Group 4 Schedule Hospital System (SHS)</h4><p>Nền tảng đặt lịch khám, quản lý hàng đợi, hồ sơ bệnh án điện tử, chỉ định cận lâm sàng và thanh toán viện phí đồng bộ.</p></div><div class="footer-col"><h4>Điều hướng nhanh</h4><ul><li><a href="#bac-si">Danh sách bác sĩ chuyên khoa</a></li><li><a href="#dat-lich">Đăng ký lịch khám trực tuyến</a></li><li><a href="<%=ctx%>/patient">Tra cứu hồ sơ &amp; lịch hẹn</a></li></ul></div><div class="footer-col"><h4>Quy định lịch hẹn</h4><ul><li>Đổi giờ khám: trước giờ hẹn ít nhất 12 giờ (tối đa 2 lần).</li><li>Hủy lịch trực tuyến: trước giờ hẹn ít nhất 2 giờ.</li><li>Khung giờ: Ca sáng 08:00–12:00 · Ca chiều 13:00–17:00.</li></ul></div></div><div class="footer-bottom"><span>&copy; 2026 Group 4 Schedule Hospital System (SHS)</span><span>SWD392 · SE1976-JS(AD) · Group 4</span></div></div></footer>
<div class="modal-backdrop" id="login-modal" hidden><section class="login-dialog" role="dialog" aria-modal="true" aria-labelledby="login-title" aria-describedby="login-note"><button class="modal-close" type="button" id="close-login" aria-label="Đóng cửa sổ đăng nhập">×</button><p class="eyebrow">CỔNG THÔNG TIN NỘI BỘ</p><h2 id="login-title">Đăng nhập nhân viên</h2><p id="login-note" class="muted">Chỉ dành cho nhân viên bệnh viện, bác sĩ và quản lý.</p><form method="post" action="<%=ctx%>/login"><input type="hidden" name="csrfToken" value="<%=esc((String)request.getAttribute("csrfToken"))%>"><div class="form-field"><label for="username">Tên đăng nhập</label><input id="username" name="username" autocomplete="username" required maxlength="50"></div><div class="form-field"><label for="password">Mật khẩu</label><input id="password" name="password" type="password" autocomplete="current-password" required></div><p id="login-error" class="field-error" role="alert"><%=esc(loginMessage)%></p><button class="button button-primary button-full" type="submit">Đăng nhập</button></form></section></div>
<script>window.HOSPITAL_CONTEXT="<%=ctx%>";</script><script src="<%=ctx%>/assets/app.js?v=2" defer></script></body></html>
