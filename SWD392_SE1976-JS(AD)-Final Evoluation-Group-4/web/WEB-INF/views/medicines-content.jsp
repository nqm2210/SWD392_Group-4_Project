<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.Medicine,jakarta.servlet.http.HttpServletRequest" %>
<%! private String escMedicine(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String medicinePosted(HttpServletRequest req,int id,String field,String fallback){try{if("POST".equals(req.getMethod())&&Integer.parseInt(req.getParameter("medicineId"))==id){String value=req.getParameter(field);if(value!=null)return value;}}catch(Exception ignored){}return fallback==null?"":fallback;} private Map<?,?> medicineErrorsFor(HttpServletRequest req,Map<?,?> errors,int id){return "POST".equals(req.getMethod())&&String.valueOf(id).equals(req.getParameter("medicineId"))?errors:null;} private String medicineError(Map<?,?> errors,String key){Object error=errors==null?null:errors.get(key);return error==null?"":"<span class=\"field-error\">"+escMedicine(error.toString())+"</span>";} %>
<%
List<Medicine> medicines=(List<Medicine>)request.getAttribute("medicines");
Map<?,?> errors=(Map<?,?>)request.getAttribute("formErrors");
String csrf=(String)request.getAttribute("csrfToken");
Map<?,?> createErrors=medicineErrorsFor(request,errors,0);
boolean createActive="POST".equals(request.getMethod())&&"0".equals(request.getParameter("medicineId"))?request.getParameter("active")!=null:true;
%>
<p class="muted">Quản lý thuốc từ bảng Medicines. Danh mục này độc lập với “Dịch vụ và giá”; không có thuốc mẫu được tạo tự động.</p>
<%if(request.getAttribute("savedMessage")!=null){%><div class="notice notice-success" role="status"><%=escMedicine(request.getAttribute("savedMessage").toString())%></div><%}%>
<%if(request.getAttribute("formError")!=null){%><div class="notice notice-error" role="alert"><%=escMedicine(request.getAttribute("formError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escMedicine(request.getAttribute("loadError").toString())%></div><%}%>
<section class="form-panel"><h3>Thêm thuốc</h3><form method="post" action="<%=request.getContextPath()%>/medicines" class="staff-edit-form"><input type="hidden" name="csrfToken" value="<%=escMedicine(csrf)%>"><input type="hidden" name="medicineId" value="0">
<div class="form-grid"><div class="form-field"><label for="new-medicine-code">Mã thuốc</label><input id="new-medicine-code" name="medicineCode" maxlength="20" required placeholder="VD: THUOC_GIAM_DAU" value="<%=escMedicine(medicinePosted(request,0,"medicineCode",""))%>"><small class="muted">Mã kỹ thuật không dấu, không khoảng trắng; tối đa 20 ký tự.</small><%=medicineError(createErrors,"medicineCode")%></div>
<div class="form-field"><label for="new-medicine-name">Tên thuốc</label><input id="new-medicine-name" name="medicineName" maxlength="100" required placeholder="Ví dụ: Thuốc giảm đau" value="<%=escMedicine(medicinePosted(request,0,"medicineName",""))%>"><%=medicineError(createErrors,"medicineName")%></div>
<div class="form-field"><label for="new-medicine-unit">Đơn vị</label><input id="new-medicine-unit" name="unit" maxlength="50" required placeholder="viên, chai, ống..." value="<%=escMedicine(medicinePosted(request,0,"unit",""))%>"><%=medicineError(createErrors,"unit")%></div>
<div class="form-field"><label for="new-medicine-price">Đơn giá (₫)</label><input id="new-medicine-price" name="unitPrice" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,15})(?:\.[0-9]{1,2})?" maxlength="19" required placeholder="100000" value="<%=escMedicine(medicinePosted(request,0,"unitPrice",""))%>"><small class="muted">Tối đa 16 chữ số phần nguyên và 2 chữ số thập phân.</small><%=medicineError(createErrors,"unitPrice")%></div>
<div class="form-field full-width"><label class="checkbox-field"><input type="checkbox" name="active" <%=createActive?"checked":""%>> Hoạt động ngay sau khi thêm</label></div></div><button class="button button-primary" type="submit">Thêm thuốc</button></form></section>
<div class="section-heading"><h3>Danh mục thuốc</h3><form class="search-form" method="get" action="<%=request.getContextPath()%>/dashboard"><input type="hidden" name="page" value="medicines"><label class="sr-only" for="medicine-search">Tìm thuốc</label><input id="medicine-search" name="q" type="search" maxlength="100" placeholder="Mã, tên hoặc đơn vị thuốc" value="<%=escMedicine(request.getParameter("q"))%>"><button class="button button-outline" type="submit">Tìm kiếm</button></form></div>
<%if(medicines==null){%><div class="empty-state"><strong>Chưa tải được danh mục thuốc.</strong><p>Kiểm tra kết nối database rồi thử lại.</p></div><%}else if(medicines.isEmpty()){%><div class="empty-state"><strong>Chưa có thuốc khớp với tìm kiếm.</strong><p>Manager có thể thêm thuốc thật vào danh mục phía trên.</p></div><%}else{%><div class="doctor-admin-list"><%for(Medicine medicine:medicines){int id=medicine.id();Map<?,?> rowErrors=medicineErrorsFor(request,errors,id);boolean active="POST".equals(request.getMethod())&&String.valueOf(id).equals(request.getParameter("medicineId"))?request.getParameter("active")!=null:medicine.active();String code=medicinePosted(request,id,"medicineCode",medicine.code()),name=medicinePosted(request,id,"medicineName",medicine.name()),unit=medicinePosted(request,id,"unit",medicine.unit()),price=medicinePosted(request,id,"unitPrice",medicine.unitPrice().toPlainString());%>
<article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3><%=escMedicine(medicine.name())%></h3><p><%=escMedicine(medicine.code())%> · <%=escMedicine(medicine.unit())%></p><p class="muted"><%=medicine.active()?"Đang hoạt động":"Đã tạm ngưng"%></p></div><strong><%=String.format("%,.0f",medicine.unitPrice())%> ₫</strong></div>
<details class="doctor-edit"><summary>Chỉnh sửa thuốc</summary><form method="post" action="<%=request.getContextPath()%>/medicines" class="staff-edit-form"><input type="hidden" name="csrfToken" value="<%=escMedicine(csrf)%>"><input type="hidden" name="medicineId" value="<%=id%>"><div class="form-grid">
<div class="form-field"><label for="medicine-code-<%=id%>">Mã thuốc</label><input id="medicine-code-<%=id%>" name="medicineCode" maxlength="20" required value="<%=escMedicine(code)%>"><%=medicineError(rowErrors,"medicineCode")%></div>
<div class="form-field"><label for="medicine-name-<%=id%>">Tên thuốc</label><input id="medicine-name-<%=id%>" name="medicineName" maxlength="100" required value="<%=escMedicine(name)%>"><%=medicineError(rowErrors,"medicineName")%></div>
<div class="form-field"><label for="medicine-unit-<%=id%>">Đơn vị</label><input id="medicine-unit-<%=id%>" name="unit" maxlength="50" required value="<%=escMedicine(unit)%>"><%=medicineError(rowErrors,"unit")%></div>
<div class="form-field"><label for="medicine-price-<%=id%>">Đơn giá (₫)</label><input id="medicine-price-<%=id%>" name="unitPrice" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,15})(?:\.[0-9]{1,2})?" maxlength="19" required value="<%=escMedicine(price)%>"><%=medicineError(rowErrors,"unitPrice")%></div>
<div class="form-field full-width"><label class="checkbox-field"><input type="checkbox" name="active" <%=active?"checked":""%>> Đang hoạt động</label></div></div><button class="button button-primary" type="submit">Lưu thuốc</button></form></details></article><%}%></div><%}%>
