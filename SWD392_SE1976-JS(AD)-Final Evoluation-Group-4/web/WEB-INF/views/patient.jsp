<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,java.time.LocalDate,hospital.model.PatientAppointment,hospital.model.AppointmentChange,hospital.model.Doctor" %>
<%! private String escPatient(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String patientError(Map<?,?> errors,String key){Object error=errors==null?null:errors.get(key);return error==null?"":"<span class=\"field-error\">"+escPatient(error.toString())+"</span>";} private String patientStatus(String value){if(value==null)return "Không rõ";if("BOOKED".equals(value))return "Đã đặt";if("CHECKED_IN".equals(value))return "Đã check-in";if("IN_CONSULTATION".equals(value))return "Đang khám";if("COMPLETED".equals(value))return "Hoàn tất";if("CANCELLED".equals(value))return "Đã hủy";if("NEEDS_PROCESSING".equals(value))return "Cần xử lý";if("UNPAID".equals(value))return "Chưa thanh toán";if("PAID".equals(value))return "Đã thanh toán";return value;} %>
<%
String ctx=request.getContextPath();String csrf=(String)request.getAttribute("csrfToken");
Integer verifiedPatientId=(Integer)session.getAttribute("verifiedPatientId");
Map<?,?> fieldErrors=(Map<?,?>)request.getAttribute("fieldErrors");
List<PatientAppointment> appointments=(List<PatientAppointment>)request.getAttribute("patientAppointments");
List<AppointmentChange> changes=(List<AppointmentChange>)request.getAttribute("appointmentChanges");
List<Doctor> doctors=(List<Doctor>)request.getAttribute("doctors");
%>
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin bệnh nhân | Group 4 Schedule Hospital System (SHS)</title><link rel="stylesheet" href="<%=ctx%>/assets/styles.css?v=4"></head><body>
<div class="top-bar"><div class="container top-bar-row"><div class="top-bar-items"><span class="top-bar-badge">SHS PATIENT PORTAL</span><span>Group 4 Schedule Hospital System · Cổng tra cứu &amp; quản lý lịch hẹn bệnh nhân</span></div><div class="top-bar-items"><span>Bảo mật mã truy cập SHA-256</span></div></div></div>
<header class="site-header"><div class="container header-row"><a class="brand" href="<%=ctx%>/"><span class="brand-mark">SHS</span><span>Group 4 Schedule Hospital System<small>SHS · Cổng thông tin bệnh nhân</small></span></a><nav class="top-nav"><a href="<%=ctx%>/">Trang chủ</a><a href="<%=ctx%>/#bac-si">Đội ngũ bác sĩ</a><a href="<%=ctx%>/#dat-lich">Đặt lịch khám</a></nav></div></header>
<main class="section container"><div class="section-heading"><div><p class="eyebrow">CỔNG BỆNH NHÂN</p><h1>Tra cứu lịch khám</h1><p class="muted">Chỉ hiển thị sau khi xác minh bằng thông tin đã đăng ký và mã truy cập.</p></div></div>
<%if(verifiedPatientId==null){%>
<section class="form-panel"><h2>Xác minh hồ sơ</h2><p class="muted">Nhập số điện thoại hoặc email đã đăng ký cùng mã truy cập được cấp sau khi đặt lịch.</p>
<%if(request.getAttribute("accessError")!=null){%><div class="notice notice-error" role="alert"><%=escPatient(request.getAttribute("accessError").toString())%></div><%}%>
<form method="post" action="<%=ctx%>/patient" class="form-grid"><input type="hidden" name="csrfToken" value="<%=escPatient(csrf)%>"><input type="hidden" name="action" value="verify"><div class="form-field"><label for="contact">Số điện thoại hoặc email</label><input id="contact" name="contact" maxlength="100" autocomplete="username" required value="<%=escPatient(request.getParameter("contact"))%>"></div><div class="form-field"><label for="accessCode">Mã truy cập bệnh nhân</label><input id="accessCode" name="accessCode" type="password" maxlength="50" autocomplete="off" required aria-describedby="access-code-note"></div><p id="access-code-note" class="form-note full-width">Không gửi mã qua URL hoặc cho người khác. Hồ sơ cũ chưa nhận mã cần được xác minh trực tiếp tại quầy.</p><div class="form-field full-width"><button class="button button-primary" type="submit">Xác minh và tra cứu</button></div></form></section>
<%}else{%>
<div class="button-row"><form method="post" action="<%=ctx%>/patient"><input type="hidden" name="csrfToken" value="<%=escPatient(csrf)%>"><input type="hidden" name="action" value="logout"><button class="button button-outline" type="submit">Kết thúc tra cứu</button></form></div>
<%if(Boolean.TRUE.equals(request.getAttribute("updated"))){%><div class="notice notice-success" role="status">Thay đổi đã được lưu vào database.</div><%}%>
<%if(Boolean.TRUE.equals(request.getAttribute("cancelled"))){%><div class="notice notice-success" role="status">Đã hủy lịch hẹn thành công. Khung giờ đã được mở lại cho người khác.</div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escPatient(request.getAttribute("loadError").toString())%></div><%}else if(appointments==null||appointments.isEmpty()){%><div class="empty-state"><strong>Chưa có lịch hẹn trong hồ sơ này.</strong><p>Nếu bạn vừa đặt lịch, vui lòng tải lại sau ít phút hoặc liên hệ bệnh viện.</p></div><%}else{%>
<h2>Lịch hẹn của bạn</h2><div class="doctor-admin-list"><%for(PatientAppointment appointment:appointments){String start=appointment.startTime()==null?"":appointment.startTime().toString().substring(0,5);String end=appointment.endTime()==null?"":appointment.endTime().toString().substring(0,5);boolean editable="BOOKED".equalsIgnoreCase(appointment.status())&&appointment.editable();boolean reschedulable=editable&&appointment.reschedulable();boolean isThisEdit=String.valueOf(appointment.appointmentId()).equals(request.getParameter("appointmentId"))&&(fieldErrors!=null||request.getAttribute("updateError")!=null);boolean isThisCancel=String.valueOf(appointment.appointmentId()).equals(request.getAttribute("cancelAppointmentId"))&&request.getAttribute("cancelError")!=null;%>
<article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3>Mã lịch <%=escPatient(appointment.appointmentNumber())%></h3><p><%=escPatient(appointment.doctorName())%> · <%=escPatient(appointment.department())%></p><p><%=escPatient(appointment.appointmentDate().toString())%> · <%=escPatient(start)%><%if(!end.isBlank()){%>–<%=escPatient(end)%><%}%> · <%=escPatient(patientStatus(appointment.status()))%></p><p class="muted">Lý do: <%=escPatient(appointment.reason())%></p><%if(appointment.billId()!=null){%><p class="muted">Hóa đơn: <%=escPatient(patientStatus(appointment.billStatus()))%><%if(appointment.billAmount()!=null){%> · <%=String.format("%,.0f",appointment.billAmount())%> ₫<%}%></p><%}%></div></div>
<%if(editable){%><details class="form-panel" <%=isThisEdit?"open":""%>><summary><%=reschedulable?"Sửa lý do hoặc đổi lịch":"Sửa lý do khám"%></summary><p class="muted"><%if(reschedulable){%>Có thể đổi lịch khi còn hơn 12 giờ trước giờ khám; mỗi lịch tối đa 2 lần đổi. Giờ khả dụng lấy từ lịch đã công bố.<%}else{%>Lý do khám có thể sửa trước giờ khám. Việc đổi ngày/giờ đã bị khóa theo quy định còn dưới 12 giờ.<%}%></p>
<%if(isThisEdit&&request.getAttribute("updateError")!=null){%><div class="notice notice-error" role="alert"><%=escPatient(request.getAttribute("updateError").toString())%></div><%}%>
<form class="form-grid patient-change-form" method="post" action="<%=ctx%>/patient" data-reschedulable="<%=reschedulable%>" data-current-doctor="<%=appointment.doctorId()%>" data-current-date="<%=appointment.appointmentDate()%>" data-current-shift="<%="Ca sáng".equals(appointment.shift())?"AM":"PM"%>" data-current-slot="<%=appointment.slotId()%>" data-current-time="<%=escPatient(start+"–"+end)%>"><input type="hidden" name="csrfToken" value="<%=escPatient(csrf)%>"><input type="hidden" name="action" value="updateAppointment"><input type="hidden" name="appointmentId" value="<%=appointment.appointmentId()%>">
<div class="form-field full-width"><label for="reason-<%=appointment.appointmentId()%>">Lý do khám</label><textarea id="reason-<%=appointment.appointmentId()%>" name="reason" maxlength="255" required><%=escPatient(request.getParameter("appointmentId")!=null&&request.getParameter("appointmentId").equals(String.valueOf(appointment.appointmentId()))?request.getParameter("reason"):appointment.reason())%></textarea><%=isThisEdit?patientError(fieldErrors,"reason"):""%></div>
<%if(reschedulable){String postedDoctor=request.getParameter("appointmentId")!=null&&request.getParameter("appointmentId").equals(String.valueOf(appointment.appointmentId()))?request.getParameter("doctorId"):null;String postedDate=request.getParameter("appointmentId")!=null&&request.getParameter("appointmentId").equals(String.valueOf(appointment.appointmentId()))?request.getParameter("appointmentDate"):null;String postedShift=request.getParameter("appointmentId")!=null&&request.getParameter("appointmentId").equals(String.valueOf(appointment.appointmentId()))?request.getParameter("shift"):null;String postedSlot=request.getParameter("appointmentId")!=null&&request.getParameter("appointmentId").equals(String.valueOf(appointment.appointmentId()))?request.getParameter("slotId"):null;%>
<div class="form-field"><label for="doctor-<%=appointment.appointmentId()%>">Bác sĩ</label><select id="doctor-<%=appointment.appointmentId()%>" name="doctorId" required><%if(doctors!=null)for(Doctor doctor:doctors){String chosen=postedDoctor==null?String.valueOf(appointment.doctorId()):postedDoctor;%><option value="<%=doctor.id()%>" <%=String.valueOf(doctor.id()).equals(chosen)?"selected":""%>><%=escPatient(doctor.title()+" "+doctor.fullName()+" — "+doctor.specialization())%></option><%}%></select><%=isThisEdit?patientError(fieldErrors,"doctorId"):""%></div>
<div class="form-field"><label for="date-<%=appointment.appointmentId()%>">Ngày khám</label><input id="date-<%=appointment.appointmentId()%>" name="appointmentDate" type="date" min="<%=LocalDate.now()%>" value="<%=escPatient(postedDate==null?appointment.appointmentDate().toString():postedDate)%>" required><%=isThisEdit?patientError(fieldErrors,"appointmentDate"):""%></div>
<div class="form-field"><label for="shift-<%=appointment.appointmentId()%>">Ca khám</label><select id="shift-<%=appointment.appointmentId()%>" name="shift" required><option value="AM" <%="AM".equals(postedShift==null?("Ca sáng".equals(appointment.shift())?"AM":"PM"):postedShift)?"selected":""%>>Ca sáng</option><option value="PM" <%="PM".equals(postedShift==null?("Ca chiều".equals(appointment.shift())?"PM":"AM"):postedShift)?"selected":""%>>Ca chiều</option></select><%=isThisEdit?patientError(fieldErrors,"shift"):""%></div>
<div class="form-field"><label for="slot-<%=appointment.appointmentId()%>">Khung giờ</label><select id="slot-<%=appointment.appointmentId()%>" name="slotId" data-posted="<%=escPatient(postedSlot)%>" required><option value="<%=appointment.slotId()%>">Giữ khung giờ hiện tại (<%=escPatient(start)%>)</option><%if(postedSlot!=null&&!postedSlot.equals(String.valueOf(appointment.slotId()))){%><option value="<%=escPatient(postedSlot)%>" selected>Khung giờ đã chọn</option><%}%></select><small class="muted slot-help" role="status"></small><%=isThisEdit?patientError(fieldErrors,"slotId"):""%></div>
<%}%><div class="form-field full-width"><button class="button button-primary" type="submit">Lưu thay đổi</button></div></form></details>
<details class="form-panel" <%=isThisCancel?"open":""%>><summary>Hủy lịch hẹn này</summary>
<p class="muted">Hủy trực tuyến khi còn ít nhất 2 giờ trước giờ khám. Khung giờ sẽ được giải phóng cho bệnh nhân khác.</p>
<%if(isThisCancel){%><div class="notice notice-error" role="alert"><%=escPatient(request.getAttribute("cancelError").toString())%></div><%}%>
<form class="form-grid" method="post" action="<%=ctx%>/patient" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn này? Khung giờ sẽ được mở lại cho người khác.')">
<input type="hidden" name="csrfToken" value="<%=escPatient(csrf)%>">
<input type="hidden" name="action" value="cancelAppointment">
<input type="hidden" name="appointmentId" value="<%=appointment.appointmentId()%>">
<div class="form-field full-width"><label for="cancel-reason-<%=appointment.appointmentId()%>">Lý do hủy *</label>
<textarea id="cancel-reason-<%=appointment.appointmentId()%>" name="cancellationReason" maxlength="255" required placeholder="Nhập lý do bạn muốn hủy lịch khám"></textarea></div>
<div class="form-field full-width"><button class="button button-outline" type="submit">Xác nhận hủy lịch</button></div>
</form>
</details>
<%}else if("BOOKED".equalsIgnoreCase(appointment.status())){%><p class="muted">Lịch chỉ đọc vì đã qua giờ khám hoặc còn dưới thời hạn được sửa.</p><%}%></article><%}%></div><%}%>
<h2>Lịch sử thay đổi lịch hẹn</h2><%if(changes==null||changes.isEmpty()){%><p class="muted">Chưa có thay đổi lịch hẹn được ghi nhận.</p><%}else{%><div class="table-scroll"><table class="data-table"><thead><tr><th>Thời điểm</th><th>Mã lịch</th><th>Thay đổi</th><th>Chi tiết</th></tr></thead><tbody><%for(AppointmentChange change:changes){%><tr><td><%=change.changedAt()==null?"":change.changedAt().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%></td><td><%=escPatient(change.appointmentNumber())%></td><td><%if("PATIENT_CANCEL".equals(change.action())){%>Bệnh nhân hủy lịch<%}else if("RECEPTIONIST_CANCEL".equals(change.action())){%>Lễ tân hủy lịch<%}else if("PATIENT_RESCHEDULE".equals(change.action())){%>Đổi lịch<%}else{%>Cập nhật lý do<%}%></td><td><%=escPatient(change.details())%></td></tr><%}%></tbody></table></div><%}%>
<%}%>
</main><footer class="site-footer"><div class="container"><div class="footer-bottom" style="padding-top:0"><span>Group 4 Schedule Hospital System (SHS) · Cổng thông tin dành cho hồ sơ bệnh nhân đã xác minh</span><span>SWD392 · SE1976-JS(AD) · Group 4</span></div></div></footer>
<script>
(()=>{document.querySelectorAll('.patient-change-form[data-reschedulable="true"]').forEach(form=>{const doctor=form.querySelector('[name="doctorId"]'),date=form.querySelector('[name="appointmentDate"]'),shift=form.querySelector('[name="shift"]'),slot=form.querySelector('[name="slotId"]'),help=form.querySelector('.slot-help');let activeRequest;let requestVersion=0;async function loadSlots(){const version=++requestVersion;if(activeRequest)activeRequest.abort();slot.replaceChildren(new Option('Đang tải khung giờ…',''));slot.disabled=true;activeRequest=new AbortController();try{const url=new URL('<%=ctx%>/slots',location.origin);url.searchParams.set('doctorId',doctor.value);url.searchParams.set('date',date.value);url.searchParams.set('shift',shift.value);const response=await fetch(url,{signal:activeRequest.signal});if(!response.ok)throw new Error();const slots=await response.json();if(version!==requestVersion)return;slot.replaceChildren(new Option(slots.length?'Chọn khung giờ':'Không có khung giờ',''));if(doctor.value===form.dataset.currentDoctor&&date.value===form.dataset.currentDate&&shift.value===form.dataset.currentShift){slot.add(new Option('Giữ khung giờ hiện tại ('+form.dataset.currentTime+')',form.dataset.currentSlot));}for(const item of slots)slot.add(new Option(item.label,item.id));const posted=slot.dataset.posted;if(posted&&Array.from(slot.options).some(option=>option.value===posted))slot.value=posted;slot.disabled=slots.length===0&&!(doctor.value===form.dataset.currentDoctor&&date.value===form.dataset.currentDate&&shift.value===form.dataset.currentShift);if(slots.length)help.textContent='Chỉ giờ đã công bố và còn trống được hiển thị.';else if(response.headers.get('X-Slot-Availability')==='NOT_PUBLISHED')help.textContent='Bác sĩ chưa công bố lịch cho ngày và ca này. Vui lòng chọn ca hoặc ngày khác.';else help.textContent='Lịch đã công bố nhưng không còn giờ trống; có thể giữ giờ hiện tại nếu chưa đổi lịch.';}catch(error){if(error.name==='AbortError'||version!==requestVersion)return;slot.replaceChildren(new Option('Không tải được khung giờ',''));help.textContent='Không thể tải giờ từ database. Thử lại sau.';}}[doctor,date,shift].forEach(control=>control.addEventListener('change',loadSlots));});})();
</script></body></html>
