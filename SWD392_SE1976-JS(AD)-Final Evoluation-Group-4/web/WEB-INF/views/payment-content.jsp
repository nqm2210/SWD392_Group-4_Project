<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,hospital.model.BillSummary" %>
<%! private String escBill(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} private String billStatus(String value){if("UNPAID".equalsIgnoreCase(value))return "Chưa thanh toán";if("PAID".equalsIgnoreCase(value))return "Đã thanh toán";return value==null?"Không rõ":value;} %>
<%
List<BillSummary> bills=(List<BillSummary>)request.getAttribute("bills");String csrf=(String)request.getAttribute("csrfToken");
%>
<p class="muted">Hóa đơn chỉ được tạo khi Doctor hoàn tất lượt khám và các chỉ định dịch vụ đã hoàn tất, kết quả phát hành. Thanh toán tại quầy hiện chỉ ghi nhận tiền mặt; SRS có nhắc cổng điện tử nhưng ứng dụng chưa có tích hợp cổng.</p>
<p class="muted">Tổng tiền theo schema SDS/SQL Server hiện có: phí khám + dịch vụ đã hoàn tất/phát hành. SRS còn nhắc phí thuốc, nhưng bảng Bills hiện không có thành phần/tổng thuốc riêng nên chưa cộng được an toàn.</p>
<%if(Boolean.TRUE.equals(request.getAttribute("paid"))&&request.getAttribute("paidReceipt")!=null){%><div class="notice notice-success" role="status">Đã ghi nhận thanh toán. Số biên nhận: <strong><%=escBill(request.getAttribute("paidReceipt").toString())%></strong></div><%}%>
<%if(request.getAttribute("paymentError")!=null){%><div class="notice notice-error" role="alert"><%=escBill(request.getAttribute("paymentError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escBill(request.getAttribute("loadError").toString())%></div><%}else if(bills==null||bills.isEmpty()){%><div class="empty-state"><strong>Chưa có hóa đơn.</strong><p>Đặt lịch không tạo bill. Hóa đơn xuất hiện sau khi lượt khám được hoàn tất trong database.</p></div><%}else{%>
<div class="doctor-admin-list"><%for(BillSummary bill:bills){%><article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3>Hóa đơn <%=escBill(bill.billNumber())%> · <%=escBill(billStatus(bill.paymentStatus()))%></h3><p>Lịch <%=escBill(bill.appointmentNumber())%> · <%=escBill(bill.patientName())%></p><p><%=escBill(bill.doctorName())%><%=bill.department()==null?"":" · "+escBill(bill.department())%></p><p>Phí khám: <%=String.format("%,.0f",bill.consultationFee())%> ₫ · Dịch vụ: <%=String.format("%,.0f",bill.serviceAmount())%> ₫</p><p><strong>Tổng tiền: <%=String.format("%,.0f",bill.totalAmount())%> ₫</strong></p><%if(bill.receiptNumber()!=null){%><p class="notice notice-success">Biên nhận: <strong><%=escBill(bill.receiptNumber())%></strong> · Tiền thực thu: <%=bill.amountPaid()==null?"":String.format("%,.0f",bill.amountPaid())+" ₫"%><%if(bill.paidAt()!=null){%> · <%=bill.paidAt().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%><%}%></p><%}%></div></div>
<%if("UNPAID".equalsIgnoreCase(bill.paymentStatus())){%><form method="post" action="<%=request.getContextPath()%>/reception/payments"><input type="hidden" name="csrfToken" value="<%=escBill(csrf)%>"><input type="hidden" name="billId" value="<%=bill.billId()%>"><button class="button button-primary" type="submit">Thu tiền mặt và lập biên nhận</button></form><%}%></article><%}%></div><%}%>
