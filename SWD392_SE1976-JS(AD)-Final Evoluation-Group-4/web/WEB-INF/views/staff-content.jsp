<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,java.math.BigDecimal,jakarta.servlet.http.HttpServletRequest,hospital.model.DoctorProfile,hospital.model.Department" %>
<%!
private String escStaff(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private String postedValue(HttpServletRequest req,DoctorProfile doctor,String field,String fallback){try{if("POST".equals(req.getMethod())&&Integer.parseInt(req.getParameter("doctorId"))==doctor.doctorId()){String value=req.getParameter(field);if(value!=null)return value;}}catch(Exception ignored){}return fallback==null?"":fallback;}
private String postedStaffValue(HttpServletRequest req,DoctorProfile staff,String field,String fallback){if("POST".equals(req.getMethod())&&"updateStaff".equals(req.getParameter("action"))&&String.valueOf(staff.userId()).equals(req.getParameter("userId"))){String value=req.getParameter(field);if(value!=null)return value;}return fallback==null?"":fallback;}
private String fieldError(Map<?,?> errors,String key){Object error=errors==null?null:errors.get(key);return error==null?"":"<span class=\"field-error\">"+escStaff(error.toString())+"</span>";}
%>
<%
List<DoctorProfile> doctors=(List<DoctorProfile>)request.getAttribute("doctors");
List<DoctorProfile> staffAccounts=(List<DoctorProfile>)request.getAttribute("staffAccounts");
List<Department> departments=(List<Department>)request.getAttribute("departments");
Map<?,?> errors=(Map<?,?>)request.getAttribute("formErrors");
Map<?,?> staffErrors=(Map<?,?>)request.getAttribute("staffFormErrors");
%>
<p class="muted">Quản lý thông tin hồ sơ, tài khoản đăng nhập (Username) và đặt lại mật khẩu cho Bác sĩ, Lễ tân và Nhân viên y tế.</p>
<%if(request.getAttribute("savedMessage")!=null){%><div class="notice notice-success" role="status"><%=escStaff(request.getAttribute("savedMessage").toString())%></div><%}%>
<%if(request.getAttribute("formError")!=null){%><div class="notice notice-error" role="alert"><%=escStaff(request.getAttribute("formError").toString())%></div><%}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice notice-error" role="alert"><%=escStaff(request.getAttribute("loadError").toString())%></div><%}%>
<h3>Danh sách Bác sĩ</h3>
<%if(doctors==null||doctors.isEmpty()){%><div class="empty-state"><strong>Chưa có hồ sơ bác sĩ.</strong><p>Hồ sơ bác sĩ sẽ xuất hiện tại đây sau khi được thêm vào database.</p></div><%}else{%>
<div class="doctor-admin-list">
<%for(DoctorProfile doctor:doctors){boolean edited="POST".equals(request.getMethod())&&String.valueOf(doctor.doctorId()).equals(request.getParameter("doctorId"));Map<?,?> activeErrors=edited?errors:null;String username=postedValue(request,doctor,"username",doctor.username());String fullName=postedValue(request,doctor,"fullName",doctor.fullName());String email=postedValue(request,doctor,"email",doctor.email());String phone=postedValue(request,doctor,"phone",doctor.phone());String departmentId=postedValue(request,doctor,"departmentId",String.valueOf(doctor.departmentId()));String specialization=postedValue(request,doctor,"specialization",doctor.specialization());String title=postedValue(request,doctor,"academicTitle",doctor.academicTitle());String room=postedValue(request,doctor,"roomNumber",doctor.roomNumber());String fee=postedValue(request,doctor,"fee",doctor.consultationFee().toPlainString());String status=postedValue(request,doctor,"status",doctor.status());boolean published=edited?request.getParameter("published")!=null:doctor.published();%>
<article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3><%=escStaff(doctor.academicTitle())%> <%=escStaff(doctor.fullName())%></h3><p><%=escStaff(doctor.specialization())%> · <%=escStaff(doctor.departmentName())%> · Phòng <%=escStaff(doctor.roomNumber())%></p><p class="muted">Tài khoản <%=escStaff(doctor.username())%> · <%=doctor.published()?"Đang công khai":"Chưa công khai"%></p></div><strong><%=String.format("%,.0f",doctor.consultationFee())%> ₫</strong></div>
<details class="doctor-edit" <%=edited?"open":""%>><summary>Chỉnh sửa hồ sơ</summary><form method="post" action="<%=request.getContextPath()%>/staff" class="staff-edit-form">
<input type="hidden" name="csrfToken" value="<%=escStaff((String)request.getAttribute("csrfToken"))%>"><input type="hidden" name="doctorId" value="<%=doctor.doctorId()%>">
<div class="form-grid"><div class="form-field"><label for="username-doctor-<%=doctor.doctorId()%>">Tên đăng nhập (Username)</label><input id="username-doctor-<%=doctor.doctorId()%>" name="username" maxlength="50" required value="<%=escStaff(username)%>"><%=fieldError(activeErrors,"username")%></div>
<div class="form-field"><label for="password-doctor-<%=doctor.doctorId()%>">Mật khẩu mới (để trống nếu giữ nguyên)</label><input id="password-doctor-<%=doctor.doctorId()%>" type="password" name="newPassword" maxlength="72" autocomplete="new-password" placeholder="Nhập tối thiểu 6 ký tự để đổi mật khẩu"><%=fieldError(activeErrors,"newPassword")%></div>
<div class="form-field"><label for="name-<%=doctor.doctorId()%>">Họ tên</label><input id="name-<%=doctor.doctorId()%>" name="fullName" maxlength="100" required value="<%=escStaff(fullName)%>"><%=fieldError(activeErrors,"fullName")%></div>
<div class="form-field"><label for="email-<%=doctor.doctorId()%>">Email</label><input id="email-<%=doctor.doctorId()%>" type="email" name="email" maxlength="100" required value="<%=escStaff(email)%>"><%=fieldError(activeErrors,"email")%></div>
<div class="form-field"><label for="phone-<%=doctor.doctorId()%>">Số điện thoại</label><input id="phone-<%=doctor.doctorId()%>" name="phone" maxlength="20" required value="<%=escStaff(phone)%>"><%=fieldError(activeErrors,"phone")%></div>
<div class="form-field"><label for="dept-<%=doctor.doctorId()%>">Khoa</label><select id="dept-<%=doctor.doctorId()%>" name="departmentId" required><%for(Department department:departments){%><option value="<%=department.id()%>" <%=String.valueOf(department.id()).equals(departmentId)?"selected":""%>><%=escStaff(department.name())%></option><%}%></select><%=fieldError(activeErrors,"departmentId")%></div>
<div class="form-field"><label for="specialty-<%=doctor.doctorId()%>">Chuyên khoa</label><input id="specialty-<%=doctor.doctorId()%>" name="specialization" maxlength="100" required value="<%=escStaff(specialization)%>"><%=fieldError(activeErrors,"specialization")%></div>
<div class="form-field"><label for="title-<%=doctor.doctorId()%>">Chức danh</label><input id="title-<%=doctor.doctorId()%>" name="academicTitle" maxlength="50" value="<%=escStaff(title)%>"><%=fieldError(activeErrors,"academicTitle")%></div>
<div class="form-field"><label for="room-<%=doctor.doctorId()%>">Phòng khám</label><input id="room-<%=doctor.doctorId()%>" name="roomNumber" maxlength="20" required value="<%=escStaff(room)%>"><%=fieldError(activeErrors,"roomNumber")%></div>
<div class="form-field"><label for="fee-<%=doctor.doctorId()%>">Phí khám (₫)</label><input id="fee-<%=doctor.doctorId()%>" type="text" inputmode="decimal" pattern="(?:0|[1-9][0-9]{0,15})(?:\.[0-9]{1,2})?" maxlength="19" name="fee" required value="<%=escStaff(fee)%>"><%=fieldError(activeErrors,"fee")%></div>
<div class="form-field"><label for="status-<%=doctor.doctorId()%>">Trạng thái</label><select id="status-<%=doctor.doctorId()%>" name="status"><option value="Available" <%="Available".equals(status)?"selected":""%>>Đang nhận khám</option><option value="Unavailable" <%="Unavailable".equals(status)?"selected":""%>>Tạm ngưng</option></select><%=fieldError(activeErrors,"status")%></div>
<label class="checkbox-field"><input type="checkbox" name="published" <%=published?"checked":""%>> Công khai trên trang chủ</label></div>
<button class="button button-primary" type="submit">Lưu hồ sơ</button></form></details></article>
<%}%></div><%}%>

<h3>Tài khoản Lễ tân &amp; Nhân viên y tế</h3>
<%if(staffAccounts==null||staffAccounts.isEmpty()){%><div class="empty-state"><strong>Chưa có tài khoản Lễ tân hoặc Nhân viên y tế.</strong><p>Các tài khoản hiện có sẽ xuất hiện tại đây.</p></div><%}else{%>
<div class="doctor-admin-list">
<%for(DoctorProfile staff:staffAccounts){boolean editedStaff="POST".equals(request.getMethod())&&"updateStaff".equals(request.getParameter("action"))&&String.valueOf(staff.userId()).equals(request.getParameter("userId"));Map<?,?> activeStaffErrors=editedStaff?staffErrors:null;String staffUsername=postedStaffValue(request,staff,"username",staff.username());String staffName=postedStaffValue(request,staff,"fullName",staff.fullName());String staffEmail=postedStaffValue(request,staff,"email",staff.email());String staffPhone=postedStaffValue(request,staff,"phone",staff.phone());String staffDepartmentId=postedStaffValue(request,staff,"departmentId",String.valueOf(staff.departmentId()));boolean active=editedStaff?request.getParameter("active")!=null:staff.published();%>
<article class="doctor-admin-card"><div class="doctor-admin-summary"><div><h3><%=escStaff(staff.academicTitle())%> · <%=escStaff(staff.fullName())%></h3><p><%=escStaff(staff.departmentName())%></p><p class="muted">Username: <%=escStaff(staff.username())%> · Email: <%=escStaff(staff.email())%> · SĐT: <%=escStaff(staff.phone())%></p></div><strong><%=staff.published()?"Đang hoạt động":"Đã khóa"%></strong></div>
<details class="doctor-edit" <%=editedStaff?"open":""%>><summary>Chỉnh sửa tài khoản</summary><form method="post" action="<%=request.getContextPath()%>/staff" class="staff-edit-form">
<input type="hidden" name="csrfToken" value="<%=escStaff((String)request.getAttribute("csrfToken"))%>"><input type="hidden" name="action" value="updateStaff"><input type="hidden" name="userId" value="<%=staff.userId()%>">
<div class="form-grid"><div class="form-field"><label for="username-staff-<%=staff.userId()%>">Tên đăng nhập (Username)</label><input id="username-staff-<%=staff.userId()%>" name="username" maxlength="50" required value="<%=escStaff(staffUsername)%>"><%=fieldError(activeStaffErrors,"username")%></div>
<div class="form-field"><label for="password-staff-<%=staff.userId()%>">Mật khẩu mới (để trống nếu giữ nguyên)</label><input id="password-staff-<%=staff.userId()%>" type="password" name="newPassword" maxlength="72" autocomplete="new-password" placeholder="Nhập tối thiểu 6 ký tự để đổi mật khẩu"><%=fieldError(activeStaffErrors,"newPassword")%></div>
<div class="form-field"><label for="name-staff-<%=staff.userId()%>">Họ tên</label><input id="name-staff-<%=staff.userId()%>" name="fullName" maxlength="100" required value="<%=escStaff(staffName)%>"><%=fieldError(activeStaffErrors,"fullName")%></div>
<div class="form-field"><label for="email-staff-<%=staff.userId()%>">Email</label><input id="email-staff-<%=staff.userId()%>" type="email" name="email" maxlength="100" required value="<%=escStaff(staffEmail)%>"><%=fieldError(activeStaffErrors,"email")%></div>
<div class="form-field"><label for="phone-staff-<%=staff.userId()%>">Số điện thoại</label><input id="phone-staff-<%=staff.userId()%>" name="phone" maxlength="20" required value="<%=escStaff(staffPhone)%>"><%=fieldError(activeStaffErrors,"phone")%></div>
<div class="form-field"><label for="dept-staff-<%=staff.userId()%>">Khoa</label><select id="dept-staff-<%=staff.userId()%>" name="departmentId"><option value="" <%=staffDepartmentId.isEmpty()||"0".equals(staffDepartmentId)?"selected":""%>>Toàn viện / Quầy tiếp nhận</option><%for(Department department:departments){%><option value="<%=department.id()%>" <%=String.valueOf(department.id()).equals(staffDepartmentId)?"selected":""%>><%=escStaff(department.name())%></option><%}%></select><%=fieldError(activeStaffErrors,"departmentId")%></div>
<label class="checkbox-field"><input type="checkbox" name="active" <%=active?"checked":""%>> Tài khoản đang hoạt động (cho phép đăng nhập)</label></div>
<button class="button button-primary" type="submit">Lưu tài khoản</button></form></details></article>
<%}%></div><%}%>
